class DomainPolicy:
    @staticmethod
    def get_core_max_lines() -> int:
        env_val = os.environ.get("ANTIGRAVITY_CORE_MAX_LINES")
        if env_val:
            try:
                val = int(env_val.strip())
                if val > 0:
                    return val
            except ValueError:
                pass
        return DEFAULT_CORE_MAX_LINES

    @staticmethod
    def validate_namespace(ns: str) -> None:
        if not ns or not (DOMAIN_NAMESPACE_PATTERN.match(ns) or PROJECT_NAMESPACE_PATTERN.match(ns)):
            raise DomainValidationError(
                f"Invalid namespace '{ns}'. Allowed: '<domain>' (^[a-z0-9][a-z0-9_-]*$) or 'proj:<name>' (^proj:[a-zA-Z0-9._-]+$)"
            )

    @staticmethod
    def validate_kind(kind: str) -> None:
        if kind not in VALID_KINDS:
            raise DomainValidationError(f"Invalid kind '{kind}'. Must be one of {VALID_KINDS}")

    @staticmethod
    def validate_confidence(confidence: float) -> None:
        if confidence < 0.0 or confidence > 1.0:
            raise DomainValidationError(f"Invalid confidence '{confidence}'. Must be a float between 0.0 and 1.0")

    @staticmethod
    def parse_ttl(ttl_arg: str | int | None, kind: str, is_verify: bool = False) -> tuple[int | None, bool]:
        if ttl_arg is None:
            if is_verify:
                return None, False
            return (30 if kind == "fact" else None), True
        raw = str(ttl_arg).strip().lower()
        if raw in ("0", "none", "null", "~"):
            return None, True
        try:
            val = int(raw)
            if val < 0:
                raise ValueError()
            return (val if val > 0 else None), True
        except ValueError:
            raise DomainValidationError(f"Invalid --ttl value '{ttl_arg}'. Expected positive integer or '0'/'none'")

    @staticmethod
    def check_stale(updated_at_str: str, ttl_days: int | None, clock: ClockPort) -> str | None:
        if ttl_days is None or ttl_days <= 0:
            return None
        updated_dt = clock.parse_iso(updated_at_str)
        elapsed_days = int((clock.now_dt() - updated_dt).total_seconds() // 86400)
        if elapsed_days > ttl_days:
            return (
                f"⚠️ STALE MEMORY (verificada há {elapsed_days}d, TTL={ttl_days}d — "
                f"revalide no ambiente e rode 'mem verify <ns> \"<topic>\"')"
            )
        return None

    @staticmethod
    def format_fts_term(term: str, is_literal: bool = False) -> str:
        clean = term.replace('"', '""').strip()
        if not clean:
            return ""
        if " " in clean or is_literal:
            return f'"{clean}"'
        return f'"{clean}"*'

    @classmethod
    def build_fts_query(cls, user_query: str, syn_map: dict[str, list[str]]) -> tuple[str, list[str]]:
        raw_query = user_query.strip()
        if not raw_query:
            return "", []

        tokens: list[tuple[str, bool]] = []
        for quoted, word in re.findall(r'"([^"]+)"|(\S+)', raw_query):
            t = (quoted or word).strip()
            is_quoted = bool(quoted)
            if t:
                if not is_quoted and len(t) < MIN_TOKEN_LENGTH:
                    continue
                tokens.append((t, is_quoted))

        if not tokens:
            return "", []

        norm_full = raw_query.lower().strip("\"'")
        flat_words = [w for w in re.split(r"\s+", norm_full) if w]

        synonyms_found: set[str] = set()
        if norm_full in syn_map:
            synonyms_found.update(syn_map[norm_full])

        for n in (3, 2):
            for i in range(len(flat_words) - n + 1):
                ngram = " ".join(flat_words[i : i + n])
                if ngram in syn_map:
                    synonyms_found.update(syn_map[ngram])

        for w in flat_words:
            if w in syn_map:
                synonyms_found.update(syn_map[w])

        clauses: list[str] = []
        seen: set[str] = set()

        for t, is_literal in tokens:
            c = cls.format_fts_term(t, is_literal)
            if c and c.lower() not in seen:
                clauses.append(c)
                seen.add(c.lower())

        added_synonyms: list[str] = []
        for s in sorted(synonyms_found):
            if s in norm_full:
                continue
            c = cls.format_fts_term(s, is_literal=(" " in s))
            if c and c.lower() not in seen:
                clauses.append(c)
                seen.add(c.lower())
                added_synonyms.append(s)

        return " OR ".join(clauses), added_synonyms

    @classmethod
    def build_error_fts_query(cls, error_snippet: str, max_terms: int = 24) -> tuple[str, list[str]]:
        raw_words = re.findall(r"[a-zA-Z0-9_]{3,}", error_snippet)
        seen: set[str] = set()
        candidates: list[str] = []

        for token in raw_words:
            camel_parts = CAMEL_CASE_SPLIT.split(token)
            snake_parts = [p for p in token.split("_") if p]
            parts = [token] + camel_parts + snake_parts

            for part in parts:
                clean = part.lower().strip("_")
                if len(clean) >= 3 and clean not in seen and clean not in ERROR_STOPWORDS and not clean.isdigit():
                    seen.add(clean)
                    candidates.append(clean)

        candidates.sort(key=lambda x: (-len(x), x))
        selected = candidates[:max_terms]
        if not selected:
            return "", []

        clauses = [cls.format_fts_term(w, is_literal=True) for w in selected]
        return " OR ".join(clauses), selected

    @staticmethod
    def make_summary(content: str, tags: str) -> str:
        first_line = content.strip().split("\n")[0].strip()
        first_line = first_line.lstrip("#").strip().strip("*").strip()
        sentences = [s.strip() for s in re.split(r"\.\s+(?=[A-Za-z0-9])|\.\s*$", first_line) if s.strip()]
        sentence = sentences[0] if sentences else first_line
        if len(sentence) > 70:
            sentence = sentence[:67].strip() + "..."
        if sentence:
            return sentence
        if tags:
            return f"tags: {tags}"
        return "L2 record"


