def cmd_recall_error(args: argparse.Namespace) -> None:
    if args.ns:
        validate_namespace(args.ns)
    conn = get_conn()

    raw_words = re.findall(r"[a-zA-Z0-9_]{3,}", args.error_snippet)
    seen = set()
    words = []
    for w in raw_words:
        wl = w.lower()
        if wl not in seen:
            seen.add(wl)
            words.append(wl)

    if not words:
        sys.exit("Error: no searchable keywords (length >= 3) found in error snippet")

    clauses = [format_fts_term(w) for w in words]
    fts_query = " OR ".join(clauses)

    sql = """
        SELECT m.id, m.namespace, m.kind, m.topic, m.content, m.tags, m.access_count, m.ttl_days, m.updated_at,
               (bm25(memories_fts, 5.0, 1.0, 2.0, 0.5) * (1.0 + 0.15 * MIN(m.access_count, 30)) / (1.0 + 0.02 * MAX(0.0, julianday('now') - julianday(m.updated_at)))) AS hybrid_score,
               CASE WHEN m.kind IN ('learning', 'playbook') THEN 0 ELSE 1 END AS kind_priority
        FROM memories_fts
        JOIN memories m ON m.id = memories_fts.rowid
        WHERE memories_fts MATCH ?
    """
    params: list = [fts_query]
    if args.ns:
        sql += " AND m.namespace = ?"
        params.append(args.ns)
    sql += " ORDER BY kind_priority ASC, hybrid_score ASC, m.updated_at DESC LIMIT ?"
    params.append(args.limit)

    rows = conn.execute(sql, params).fetchall()
    if not rows:
        print(f"No error solutions found matching query keywords: {', '.join(words[:10])}")
        return

    ids = [r["id"] for r in rows]
    with conn:
        conn.executemany("UPDATE memories SET access_count = access_count + 1 WHERE id = ?", [(i,) for i in ids])

    print(f"=== Episodic Error Recall (Matched {len(rows)} record(s)) ===")
    for r in rows:
        ttl_part = f" | ttl={r['ttl_days']}d" if r["ttl_days"] is not None else ""
        print(f"\n=== [{r['namespace']}/{r['kind']}] {r['topic']} (tags: {r['tags'] or '-'} | updated: {r['updated_at']}{ttl_part} | hits: {r['access_count'] + 1}) ===")
        stale_warn = check_stale(r["updated_at"], r["ttl_days"])
        if stale_warn:
            print(stale_warn)
        print(r["content"])


