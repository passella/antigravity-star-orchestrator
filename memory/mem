class MemoryEngineController:
    def __init__(
        self,
        repo: MemoryRepositoryPort,
        clock: ClockPort,
        mem_dir: str,
        db_path: str,
        core_path: str,
        core_template_path: str,
    ) -> None:
        self._repo = repo
        self._clock = clock
        self._mem_dir = mem_dir
        self._db_path = db_path
        self._core_path = core_path
        self._core_template_path = core_template_path
