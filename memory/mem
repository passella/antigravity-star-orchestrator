    def cmd_check_core(self, args: argparse.Namespace) -> None:
        max_lines = args.max_lines if getattr(args, "max_lines", None) is not None else DomainPolicy.get_core_max_lines()

        with file_lock(self._lock_path):
            if not os.path.exists(self._core_path):
                raise ResourceNotFoundError(f"CORE.md not found at {self._core_path}")
            with open(self._core_path, "r", encoding="utf-8") as f:
                content = f.read()

        lines = content.splitlines()
        line_count = len(lines)
        word_count = len(content.split())
        byte_count = len(content.encode("utf-8"))
        char_count = len(content)
        estimated_tokens = int(word_count * 1.33)

        exceeded = line_count > max_lines
        status = "EXCEEDED" if exceeded else "OK"
        remaining = max_lines - line_count
        due_tasks = self._repo.list_due_tasks(None)

        if getattr(args, "json", False):
            payload = {
                "status": status,
                "line_count": line_count,
                "max_lines": max_lines,
                "remaining_lines": remaining,
                "word_count": word_count,
                "byte_count": byte_count,
                "char_count": char_count,
                "estimated_tokens": estimated_tokens,
                "exceeded": exceeded,
                "path": self._core_path,
                "pending_tasks": [
                    {
                        "id": t.id,
                        "namespace": t.namespace,
                        "trigger_cond": t.trigger_cond,
                        "action": t.action,
                        "created_at": t.created_at,
                    }
                    for t in due_tasks
                ],
            }
            print(json.dumps(payload, indent=2, ensure_ascii=False))
            if exceeded:
                sys.exit(1)
            return

        print("=== CORE.md Working Memory Budget ===")
        print(f"Status: {status} ({line_count}/{max_lines} lines used, {remaining} lines remaining)")
        print(f"Density: {word_count} words | {byte_count} bytes | ~{estimated_tokens} estimated tokens")
        print(f"Path: {self._core_path}")

        print("\n=== Pending Prospective Tasks ===")
        if not due_tasks:
            print("(No pending prospective tasks)")
        else:
            for t in due_tasks:
                print(f"- #{t.id} [{t.namespace}]: [{t.trigger_cond}] -> {t.action} (created: {t.created_at})")

        if exceeded:
            sys.exit(1)

