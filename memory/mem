#!/usr/bin/env python3
"""
Antigravity Tier-2 Archival & Episodic Memory Engine (SQLite + FTS5 BM25 + Temporal Upsert).
Inspired by Letta (MemGPT), CoALA, Mem0, and Zep/Graphiti.

Features:
  - 7-Memory Evolution: Working, Episodic, Semantic Graph, Procedural, Prospective, Retrieval, Declarative.
  - Semantic Freshness / TTL (--ttl + mem verify) with stale alerts.
  - Wiki Markdown Export/Import (mem export-md + mem import-md) with YAML frontmatter & WikiLinks.
  - FTS5 BM25 hybrid ranking with access count recency & frequency scaling.
  - Dynamic technical synonyms expansion.
  - Semantic memory graph linking memories with explicit relations.
  - Prospective memory (defer, due, done) with active namespace alerts.
  - Episodic error recall with priority boosting for learning & playbook memories.
  - Working memory guardrail checking CORE.md line count budget.
  - Flexible project namespaces ('proj:<name>') alongside standard domain namespaces.
  - Topic promotion to CORE.md Semantic Directory via 'promote'.

Usage:
  mem init [--user "<name>"] [--lang "<lang>"] [--workspace "<path>"] [--force]
  mem search "<query>" [--ns <namespace>] [--limit <N>]
  mem get <namespace> "<topic>"
  mem upsert <namespace> <kind> "<topic>" "<content>" ["<tags>"] [--ttl <days>]
  mem verify <namespace> "<topic>" [--ttl <days>]
  mem list [--ns <namespace>]
  mem delete <namespace> "<topic>"
  mem promote [--ns <namespace>] [--limit <N>] [--by hits|recent] [--min-hits <N>]
  mem stats
  mem link <src_ns>:<src_topic> <relation> <dst_ns>:<dst_topic>
  mem defer <namespace> "<trigger_cond>" "<action>"
  mem due [--ns <namespace>]
  mem done <task_id>
  mem syn [list | add <term> "<syn1,syn2,...>"]
  mem recall-error "<error_snippet>" [--ns <namespace>] [--limit <N>]
  mem check-core
  mem export-md [dir] [--ns <namespace>]
  mem import-md [dir]
"""
import argparse
import os
import re
import sqlite3
import sys
from datetime import datetime, timezone

MEM_DIR = os.path.dirname(os.path.abspath(__file__))
DB_PATH = os.path.join(MEM_DIR, "archival.db")
CORE_PATH = os.path.join(MEM_DIR, "CORE.md")
CORE_TEMPLATE_PATH = os.path.join(MEM_DIR, "CORE.template.md")
VALID_KINDS = ("fact", "learning", "behavior", "decision", "invariant", "playbook")

DOMAIN_NAMESPACE_PATTERN = re.compile(r"^[a-z0-9][a-z0-9_-]*$")
PROJECT_NAMESPACE_PATTERN = re.compile(r"^proj:[a-zA-Z0-9._-]+$")

SYNONYM_GROUPS = [
    {"gc", "garbage collector", "garbage collection"},
    {"loom", "virtual threads", "virtual thread", "project loom"},
    {"ffm", "foreign function", "foreign memory", "project panama"},
    {"zgc", "shenandoah", "low latency gc"},
    {"mvcc", "concurrency", "multiversion concurrency control"},
    {"explain", "buffers", "explain analyze"},
    {"k8s", "kubernetes"},
    {"docker", "container", "containers"},
    {"hexagonal", "ports and adapters", "clean architecture"},
    {"postgres", "postgresql", "psql"},
    {"perf", "performance", "jmh", "benchmark"},
    {"jit", "c2", "graalvm"},
]

SYNONYM_MAP: dict[str, list[str]] = {}
for group in SYNONYM_GROUPS:
    for item in group:
        SYNONYM_MAP[item.lower()] = [other.lower() for other in group if other != item]


def is_valid_namespace(ns: str) -> bool:
    if not ns:
        return False
    return bool(DOMAIN_NAMESPACE_PATTERN.match(ns) or PROJECT_NAMESPACE_PATTERN.match(ns))


def validate_namespace(ns: str) -> None:
    if not is_valid_namespace(ns):
        sys.exit(
            f"Error: invalid namespace '{ns}'. Allowed: '<domain>' (^[a-z0-9][a-z0-9_-]*$) or 'proj:<name>' (^proj:[a-zA-Z0-9._-]+$)"
        )


def init_db(conn: sqlite3.Connection) -> None:
    # 1. Check existing memories schema
    row = conn.execute("SELECT sql FROM sqlite_master WHERE type='table' AND name='memories'").fetchone()
    if row is None:
        conn.executescript(
            """
            CREATE TABLE IF NOT EXISTS memories (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                namespace TEXT NOT NULL,
                kind TEXT NOT NULL CHECK(kind IN ('fact', 'learning', 'behavior', 'decision', 'invariant', 'playbook')),
                topic TEXT NOT NULL,
                content TEXT NOT NULL,
                tags TEXT DEFAULT '',
                access_count INTEGER DEFAULT 0,
                ttl_days INTEGER DEFAULT NULL,
                created_at TEXT NOT NULL,
                updated_at TEXT NOT NULL,
                UNIQUE(namespace, topic)
            );

            CREATE VIRTUAL TABLE IF NOT EXISTS memories_fts USING fts5(
                topic,
                content,
                tags,
                namespace,
                content='memories',
                content_rowid='id',
                tokenize='unicode61 remove_diacritics 2'
            );

            CREATE TRIGGER IF NOT EXISTS memories_ai AFTER INSERT ON memories BEGIN
                INSERT INTO memories_fts(rowid, topic, content, tags, namespace)
                VALUES (new.id, new.topic, new.content, new.tags, new.namespace);
            END;

            CREATE TRIGGER IF NOT EXISTS memories_ad AFTER DELETE ON memories BEGIN
                INSERT INTO memories_fts(memories_fts, rowid, topic, content, tags, namespace)
                VALUES ('delete', old.id, old.topic, old.content, old.tags, old.namespace);
            END;

            CREATE TRIGGER IF NOT EXISTS memories_au AFTER UPDATE OF topic, content, tags, namespace ON memories BEGIN
                INSERT INTO memories_fts(memories_fts, rowid, topic, content, tags, namespace)
                VALUES ('delete', old.id, old.topic, old.content, old.tags, old.namespace);
                INSERT INTO memories_fts(rowid, topic, content, tags, namespace)
                VALUES (new.id, new.topic, new.content, new.tags, new.namespace);
            END;
            """
        )
    else:
        table_sql = row[0] or ""
        if "'playbook'" not in table_sql:
            # Safe non-destructive schema migration
            conn.execute("PRAGMA foreign_keys=OFF;")
            conn.executescript(
                """
                CREATE TABLE memories_new (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    namespace TEXT NOT NULL,
                    kind TEXT NOT NULL CHECK(kind IN ('fact', 'learning', 'behavior', 'decision', 'invariant', 'playbook')),
                    topic TEXT NOT NULL,
                    content TEXT NOT NULL,
                    tags TEXT DEFAULT '',
                    access_count INTEGER DEFAULT 0,
                    ttl_days INTEGER DEFAULT NULL,
                    created_at TEXT NOT NULL,
                    updated_at TEXT NOT NULL,
                    UNIQUE(namespace, topic)
                );

                INSERT INTO memories_new (id, namespace, kind, topic, content, tags, access_count, created_at, updated_at)
                SELECT id, namespace, kind, topic, content, tags, access_count, created_at, updated_at FROM memories;

                DROP TRIGGER IF EXISTS memories_ai;
                DROP TRIGGER IF EXISTS memories_ad;
                DROP TRIGGER IF EXISTS memories_au;

                DROP TABLE memories;

                ALTER TABLE memories_new RENAME TO memories;

                CREATE TRIGGER IF NOT EXISTS memories_ai AFTER INSERT ON memories BEGIN
                    INSERT INTO memories_fts(rowid, topic, content, tags, namespace)
                    VALUES (new.id, new.topic, new.content, new.tags, new.namespace);
                END;

                CREATE TRIGGER IF NOT EXISTS memories_ad AFTER DELETE ON memories BEGIN
                    INSERT INTO memories_fts(memories_fts, rowid, topic, content, tags, namespace)
                    VALUES ('delete', old.id, old.topic, old.content, old.tags, old.namespace);
                END;

                CREATE TRIGGER IF NOT EXISTS memories_au AFTER UPDATE OF topic, content, tags, namespace ON memories BEGIN
                    INSERT INTO memories_fts(memories_fts, rowid, topic, content, tags, namespace)
                    VALUES ('delete', old.id, old.topic, old.content, old.tags, old.namespace);
                    INSERT INTO memories_fts(rowid, topic, content, tags, namespace)
                    VALUES (new.id, new.topic, new.content, new.tags, new.namespace);
                END;

                INSERT INTO memories_fts(memories_fts) VALUES('rebuild');
                """
            )
            conn.execute("PRAGMA foreign_keys=ON;")

        # Check if ttl_days column exists
        cols = [col[1] for col in conn.execute("PRAGMA table_info(memories)").fetchall()]
        if "ttl_days" not in cols:
            conn.execute("ALTER TABLE memories ADD COLUMN ttl_days INTEGER DEFAULT NULL;")

    # 2. Semantic memory graph edges
    conn.execute(
        """
        CREATE TABLE IF NOT EXISTS memory_edges (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            source_id INTEGER NOT NULL,
            target_id INTEGER NOT NULL,
            relation TEXT NOT NULL,
            created_at TEXT NOT NULL,
            UNIQUE(source_id, target_id, relation),
            FOREIGN KEY(source_id) REFERENCES memories(id) ON DELETE CASCADE,
            FOREIGN KEY(target_id) REFERENCES memories(id) ON DELETE CASCADE
        );
        """
    )

    # 3. Prospective memory tasks
    conn.execute(
        """
        CREATE TABLE IF NOT EXISTS prospective_tasks (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            namespace TEXT NOT NULL,
            trigger_cond TEXT NOT NULL,
            action TEXT NOT NULL,
            status TEXT NOT NULL DEFAULT 'pending' CHECK(status IN ('pending', 'done')),
            created_at TEXT NOT NULL,
            completed_at TEXT
        );
        """
    )

    # 4. Dynamic synonyms
    conn.execute(
        """
        CREATE TABLE IF NOT EXISTS synonyms (
            term TEXT PRIMARY KEY,
            expanded TEXT NOT NULL
        );
        """
    )

    # Seed synonyms from default SYNONYM_GROUPS if empty
    syn_count = conn.execute("SELECT COUNT(*) FROM synonyms").fetchone()[0]
    if syn_count == 0:
        for group in SYNONYM_GROUPS:
            for item in group:
                term = item.lower()
                expanded = ", ".join(sorted(other.lower() for other in group if other != item))
                conn.execute(
                    "INSERT OR IGNORE INTO synonyms (term, expanded) VALUES (?, ?)",
                    (term, expanded),
                )
        conn.commit()


def get_conn() -> sqlite3.Connection:
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode=WAL;")
    conn.execute("PRAGMA synchronous=NORMAL;")
    conn.execute("PRAGMA foreign_keys=ON;")
    init_db(conn)
    return conn


def load_synonyms(conn: sqlite3.Connection) -> dict[str, list[str]]:
    syn_map: dict[str, list[str]] = {}
    try:
        rows = conn.execute("SELECT term, expanded FROM synonyms").fetchall()
        for r in rows:
            term = r["term"].strip().lower()
            items = [s.strip().lower() for s in r["expanded"].split(",") if s.strip()]
            if items:
                syn_map[term] = items
    except Exception:
        pass
    if not syn_map:
        return SYNONYM_MAP
    return syn_map


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_iso(dt_str: str) -> datetime:
    clean = dt_str.strip()
    if clean.endswith("Z"):
        clean = clean[:-1] + "+00:00"
    try:
        dt = datetime.fromisoformat(clean)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)
        return dt
    except Exception:
        return datetime.now(timezone.utc)


def check_stale(updated_at_str: str, ttl_days: int | None) -> str | None:
    if ttl_days is None:
        return None
    try:
        ttl_int = int(ttl_days)
    except (ValueError, TypeError):
        return None
    if ttl_int <= 0:
        return None
    try:
        updated_dt = parse_iso(updated_at_str)
        now_dt = datetime.now(timezone.utc)
        elapsed_days = int((now_dt - updated_dt).total_seconds() // 86400)
        if elapsed_days > ttl_int:
            return (
                f"⚠️ STALE MEMORY (verificada há {elapsed_days}d, TTL={ttl_int}d — "
                f"revalide no ambiente e rode 'mem verify <ns> \"<topic>\"')"
            )
    except Exception:
        pass
    return None


def format_fts_term(term: str, is_literal: bool = False) -> str:
    clean = term.replace('"', '""').strip()
    if not clean:
        return ""
    if " " in clean or is_literal:
        return f'"{clean}"'
    return f'"{clean}"*'


def build_fts_query(user_query: str, syn_map: dict[str, list[str]] | None = None) -> tuple[str, list[str]]:
    raw_query = user_query.strip()
    if not raw_query:
        return "", []

    tokens: list[tuple[str, bool]] = []
    matches = re.findall(r'"([^"]+)"|(\S+)', raw_query)
    for quoted, word in matches:
        t = (quoted or word).strip()
        if t:
            tokens.append((t, bool(quoted)))

    if not tokens:
        return "", []

    norm_full = raw_query.lower().strip("\"'")
    flat_words = [w for w in re.split(r"\s+", norm_full) if w]

    if syn_map is None:
        syn_map = SYNONYM_MAP

    synonyms_found = set()
    # 1. Full query match
    if norm_full in syn_map:
        synonyms_found.update(syn_map[norm_full])

    # 2. Substrings / N-grams
    for n in (3, 2):
        for i in range(len(flat_words) - n + 1):
            ngram = " ".join(flat_words[i : i + n])
            if ngram in syn_map:
                synonyms_found.update(syn_map[ngram])

    # 3. Individual words
    for w in flat_words:
        if w in syn_map:
            synonyms_found.update(syn_map[w])

    clauses = []
    seen = set()

    # Original tokens/phrases
    for t, is_literal in tokens:
        c = format_fts_term(t, is_literal)
        if c and c.lower() not in seen:
            clauses.append(c)
            seen.add(c.lower())

    # Add synonyms
    added_synonyms = []
    for s in sorted(synonyms_found):
        if s in norm_full:
            continue
        c = format_fts_term(s, is_literal=(" " in s))
        if c and c.lower() not in seen:
            clauses.append(c)
            seen.add(c.lower())
            added_synonyms.append(s)

    return " OR ".join(clauses), added_synonyms


def make_summary(content: str, tags: str) -> str:
    first_line = content.strip().split("\n")[0].strip()
    first_line = first_line.lstrip("#").strip().strip("*").strip()
    sentences = [s.strip() for s in re.split(r'\.\s+(?=[A-Za-z0-9])|\.\s*$', first_line) if s.strip()]
    sentence = sentences[0] if sentences else first_line
    if len(sentence) > 70:
        sentence = sentence[:67].strip() + "..."
    if sentence:
        return sentence
    if tags:
        return f"tags: {tags}"
    return "L2 record"


def print_prospective_alerts(conn: sqlite3.Connection, namespaces: list[str]) -> None:
    if not namespaces:
        return
    placeholders = ",".join("?" * len(namespaces))
    tasks = conn.execute(
        f"SELECT id, namespace, trigger_cond, action FROM prospective_tasks WHERE status = 'pending' AND namespace IN ({placeholders}) ORDER BY id",
        namespaces,
    ).fetchall()
    for t in tasks:
        print(f"🔔 PROSPECTIVE DUE [{t['namespace']}]: #{t['id']} [{t['trigger_cond']}] -> {t['action']}")
    if tasks:
        print()


def cmd_upsert(args: argparse.Namespace) -> None:
    validate_namespace(args.namespace)
    if args.kind not in VALID_KINDS:
        sys.exit(f"Error: kind must be one of {VALID_KINDS}")
    conn = get_conn()
    ts = now_iso()

    ttl_days: int | None = None
    if args.ttl is not None:
        ttl_raw = str(args.ttl).strip().lower()
        if ttl_raw in ("0", "none", "null"):
            ttl_days = None
        else:
            try:
                ttl_days = int(ttl_raw)
            except ValueError:
                sys.exit(f"Error: invalid --ttl value '{args.ttl}'. Expected integer or '0'/'none'")
    else:
        ttl_days = 30 if args.kind == "fact" else None

    with conn:
        conn.execute(
            """
            INSERT INTO memories (namespace, kind, topic, content, tags, access_count, ttl_days, created_at, updated_at)
            VALUES (?, ?, ?, ?, ?, 0, ?, ?, ?)
            ON CONFLICT(namespace, topic) DO UPDATE SET
                kind = excluded.kind,
                content = excluded.content,
                tags = excluded.tags,
                ttl_days = excluded.ttl_days,
                updated_at = excluded.updated_at
            """,
            (args.namespace, args.kind, args.topic, args.content, args.tags or "", ttl_days, ts, ts),
        )
    ttl_msg = f" (ttl={ttl_days}d)" if ttl_days is not None else ""
    print(f"[OK] Upserted [{args.namespace}/{args.kind}] topic='{args.topic}'{ttl_msg} at {ts}")


def cmd_verify(args: argparse.Namespace) -> None:
    validate_namespace(args.namespace)
    conn = get_conn()
    ts = now_iso()
    row = conn.execute(
        "SELECT id, ttl_days FROM memories WHERE namespace = ? AND topic = ?",
        (args.namespace, args.topic),
    ).fetchone()
    if not row:
        sys.exit(f"Error: memory not found: [{args.namespace}] topic='{args.topic}'")

    if args.ttl is not None:
        ttl_raw = str(args.ttl).strip().lower()
        if ttl_raw in ("0", "none", "null"):
            new_ttl = None
        else:
            try:
                new_ttl = int(ttl_raw)
            except ValueError:
                sys.exit(f"Error: invalid --ttl value '{args.ttl}'. Expected integer or '0'/'none'")
        with conn:
            conn.execute(
                "UPDATE memories SET updated_at = ?, ttl_days = ? WHERE namespace = ? AND topic = ?",
                (ts, new_ttl, args.namespace, args.topic),
            )
        ttl_msg = f" (ttl={new_ttl}d)" if new_ttl is not None else " (ttl=infinite)"
    else:
        with conn:
            conn.execute(
                "UPDATE memories SET updated_at = ? WHERE namespace = ? AND topic = ?",
                (ts, args.namespace, args.topic),
            )
        ttl_msg = f" (ttl={row['ttl_days']}d)" if row["ttl_days"] is not None else ""

    print(f"[OK] Verified freshness for [{args.namespace}] topic='{args.topic}'{ttl_msg} at {ts}")


def cmd_search(args: argparse.Namespace) -> None:
    if args.ns:
        validate_namespace(args.ns)
    conn = get_conn()
    syn_map = load_synonyms(conn)
    fts_query, syns = build_fts_query(args.query, syn_map)
    if not fts_query:
        sys.exit("Error: empty search query")

    sql = """
        SELECT m.id, m.namespace, m.kind, m.topic, m.content, m.tags, m.access_count, m.ttl_days, m.updated_at,
               (bm25(memories_fts, 5.0, 1.0, 2.0, 0.5) * (1.0 + 0.15 * MIN(m.access_count, 30)) / (1.0 + 0.02 * MAX(0.0, julianday('now') - julianday(m.updated_at)))) AS hybrid_score
        FROM memories_fts
        JOIN memories m ON m.id = memories_fts.rowid
        WHERE memories_fts MATCH ?
    """
    params: list = [fts_query]
    if args.ns:
        sql += " AND m.namespace = ?"
        params.append(args.ns)
    sql += " ORDER BY hybrid_score ASC, m.updated_at DESC LIMIT ?"
    params.append(args.limit)

    rows = conn.execute(sql, params).fetchall()

    # Prospective tasks banner for queried namespace(s)
    if args.ns:
        print_prospective_alerts(conn, [args.ns])
    else:
        matched_ns = list(dict.fromkeys(r["namespace"] for r in rows))
        print_prospective_alerts(conn, matched_ns)

    if not rows:
        msg = f"No archival memories matched query='{args.query}'"
        if syns:
            msg += f" (expanded with: {', '.join(syns)})"
        if args.ns:
            msg += f" in namespace='{args.ns}'"
        print(msg)
        return

    ids = [r["id"] for r in rows]
    with conn:
        conn.executemany("UPDATE memories SET access_count = access_count + 1 WHERE id = ?", [(i,) for i in ids])

    if syns:
        print(f"[FTS5 Expanded with synonyms: {', '.join(syns)}]\n")

    for r in rows:
        ttl_part = f" | ttl={r['ttl_days']}d" if r["ttl_days"] is not None else ""
        print(f"=== [{r['namespace']}/{r['kind']}] {r['topic']} (tags: {r['tags'] or '-'} | updated: {r['updated_at']}{ttl_part} | hits: {r['access_count'] + 1}) ===")
        stale_warn = check_stale(r["updated_at"], r["ttl_days"])
        if stale_warn:
            print(stale_warn)
        print(r["content"])
        print()


def cmd_get(args: argparse.Namespace) -> None:
    validate_namespace(args.namespace)
    conn = get_conn()

    # Prospective tasks banner
    print_prospective_alerts(conn, [args.namespace])

    row = conn.execute(
        "SELECT * FROM memories WHERE namespace = ? AND topic = ?",
        (args.namespace, args.topic),
    ).fetchone()
    if not row:
        sys.exit(f"Not found: [{args.namespace}] topic='{args.topic}'")
    with conn:
        conn.execute("UPDATE memories SET access_count = access_count + 1 WHERE id = ?", (row["id"],))
    ttl_part = f" | ttl={row['ttl_days']}d" if row["ttl_days"] is not None else ""
    print(f"=== [{row['namespace']}/{row['kind']}] {row['topic']} (tags: {row['tags'] or '-'} | updated: {row['updated_at']}{ttl_part} | hits: {row['access_count'] + 1}) ===")
    stale_warn = check_stale(row["updated_at"], row["ttl_days"])
    if stale_warn:
        print(stale_warn)
    print(row["content"])

    # Query linked memories (outgoing and incoming)
    out_edges = conn.execute(
        """
        SELECT e.relation, m.namespace, m.topic
        FROM memory_edges e
        JOIN memories m ON e.target_id = m.id
        WHERE e.source_id = ?
        ORDER BY e.relation, m.namespace, m.topic
        """,
        (row["id"],),
    ).fetchall()
    in_edges = conn.execute(
        """
        SELECT e.relation, m.namespace, m.topic
        FROM memory_edges e
        JOIN memories m ON e.source_id = m.id
        WHERE e.target_id = ?
        ORDER BY e.relation, m.namespace, m.topic
        """,
        (row["id"],),
    ).fetchall()

    linked = []
    for e in out_edges:
        linked.append(f"--({e['relation']})--> [{e['namespace']}:{e['topic']}]")
    for e in in_edges:
        linked.append(f"<--({e['relation']})-- [{e['namespace']}:{e['topic']}]")
    if linked:
        print(f"\n🔗 Linked: {', '.join(linked)}")


def cmd_list(args: argparse.Namespace) -> None:
    if args.ns:
        validate_namespace(args.ns)
    conn = get_conn()
    if args.ns:
        rows = conn.execute(
            "SELECT namespace, kind, topic, tags, access_count, ttl_days, updated_at FROM memories WHERE namespace = ? ORDER BY namespace, topic",
            (args.ns,),
        ).fetchall()
    else:
        rows = conn.execute(
            "SELECT namespace, kind, topic, tags, access_count, ttl_days, updated_at FROM memories ORDER BY namespace, topic"
        ).fetchall()
    if not rows:
        print("(Archival memory is empty)" if not args.ns else f"(No memories in namespace '{args.ns}')")
        return
    for r in rows:
        ttl_part = f" | ttl={r['ttl_days']}d" if r["ttl_days"] is not None else ""
        print(f"- [{r['namespace']}/{r['kind']}] {r['topic']} (tags: {r['tags'] or '-'}{ttl_part}) | updated: {r['updated_at']} | hits: {r['access_count']}")


def cmd_delete(args: argparse.Namespace) -> None:
    validate_namespace(args.namespace)
    conn = get_conn()
    with conn:
        cur = conn.execute("DELETE FROM memories WHERE namespace = ? AND topic = ?", (args.namespace, args.topic))
    if cur.rowcount:
        print(f"[OK] Deleted [{args.namespace}] topic='{args.topic}'")
    else:
        print(f"[WARN] Topic not found: [{args.namespace}] topic='{args.topic}'")


def cmd_promote(args: argparse.Namespace) -> None:
    if args.ns:
        validate_namespace(args.ns)
    conn = get_conn()

    order_by = "m.access_count DESC, m.updated_at DESC" if args.by == "hits" else "m.updated_at DESC, m.access_count DESC"
    sql = f"""
        SELECT m.namespace, m.kind, m.topic, m.content, m.tags, m.access_count, m.ttl_days, m.updated_at
        FROM memories m
        WHERE m.access_count >= ?
    """
    params: list = [args.min_hits]
    if args.ns:
        sql += " AND m.namespace = ?"
        params.append(args.ns)
    sql += f" ORDER BY {order_by} LIMIT ?"
    params.append(args.limit)

    rows = conn.execute(sql, params).fetchall()
    if not rows:
        print("No memories qualify for promotion.")
        return

