    def _print_prospective_alerts(self, namespaces: Sequence[str]) -> None:
        if not namespaces:
            return
        tasks = self._repo.list_due_tasks(namespaces)
        for t in tasks:
            print(f"🔔 PROSPECTIVE DUE [{t.namespace}]: #{t.id} [{t.trigger_cond}] -> {t.action}")
