@contextlib.contextmanager
def file_lock(lock_path: str) -> Iterator[None]:
    os.makedirs(os.path.dirname(os.path.abspath(lock_path)), exist_ok=True)
    with open(lock_path, "a+", encoding="utf-8") as lf:
        if fcntl is not None:
            fcntl.flock(lf.fileno(), fcntl.LOCK_EX)
        elif msvcrt is not None and os.name == "nt":
            lf.seek(0)
            if os.fstat(lf.fileno()).st_size == 0:
                lf.write("\0")
                lf.flush()
            lf.seek(0)
            msvcrt.locking(lf.fileno(), msvcrt.LK_LOCK, 1)
        try:
            yield
        finally:
            if fcntl is not None:
                fcntl.flock(lf.fileno(), fcntl.LOCK_UN)
            elif msvcrt is not None and os.name == "nt":
                try:
                    lf.seek(0)
                    msvcrt.locking(lf.fileno(), msvcrt.LK_UNLCK, 1)
                except OSError:
                    pass


@contextlib.contextmanager
def immediate_transaction(conn: sqlite3.Connection) -> Iterator[sqlite3.Connection]:
    is_outer = not conn.in_transaction
    if is_outer:
        conn.execute("BEGIN IMMEDIATE;")
    try:
        yield conn
        if is_outer and conn.in_transaction:
            conn.execute("COMMIT;")
    except Exception:
        if is_outer and conn.in_transaction:
            conn.execute("ROLLBACK;")
        raise


class UtcClockAdapter:
    def now_iso(self) -> str:
        return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

    def now_dt(self) -> datetime:
        return datetime.now(timezone.utc)

    def parse_iso(self, dt_str: str) -> datetime:
        clean = dt_str.strip()
        if clean.endswith("Z"):
            clean = clean[:-1] + "+00:00"
        try:
            dt = datetime.fromisoformat(clean)
            if dt.tzinfo is None:
                dt = dt.replace(tzinfo=timezone.utc)
            return dt
        except Exception:
            return self.now_dt()


class SqliteMemoryRepository:
    def __init__(self, db_path: str) -> None:
        self._db_path = db_path
        self._conn: sqlite3.Connection | None = None

    def _get_conn(self) -> sqlite3.Connection:
        if self._conn is not None:
            return self._conn
        os.makedirs(os.path.dirname(os.path.abspath(self._db_path)), exist_ok=True)
        conn = sqlite3.connect(self._db_path, timeout=30.0, isolation_level=None)
        conn.row_factory = sqlite3.Row
        conn.execute("PRAGMA busy_timeout=30000;")
        conn.execute("PRAGMA journal_mode=WAL;")
        conn.execute("PRAGMA synchronous=NORMAL;")
        conn.execute("PRAGMA temp_store=MEMORY;")
        conn.execute("PRAGMA foreign_keys=ON;")
        version = conn.execute("PRAGMA user_version;").fetchone()[0]
        if version < SCHEMA_VERSION:
            self._ensure_schema(conn)
        self._conn = conn
        return conn

    def close(self) -> None:
        if self._conn is not None:
            self._conn.close()
            self._conn = None

    def _ensure_schema(self, conn: sqlite3.Connection) -> None:
        with immediate_transaction(conn):
            ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

            # 1. Formal schema_migrations tracking table
            conn.execute(
                """
                CREATE TABLE IF NOT EXISTS schema_migrations (
                    version INTEGER PRIMARY KEY,
                    applied_at TEXT NOT NULL,
                    description TEXT NOT NULL
                );
                """
            )

            # 2. Memories table setup or migration
            row = conn.execute("SELECT sql FROM sqlite_master WHERE type='table' AND name='memories'").fetchone()
            if row is None:
                ddl_initial = [
                    """
                    CREATE TABLE IF NOT EXISTS memories (
                        id INTEGER PRIMARY KEY AUTOINCREMENT,
                        namespace TEXT NOT NULL,
                        kind TEXT NOT NULL CHECK(kind IN ('fact', 'learning', 'behavior', 'decision', 'invariant', 'playbook')),
                        topic TEXT NOT NULL,
                        content TEXT NOT NULL,
                        tags TEXT DEFAULT '',
                        access_count INTEGER DEFAULT 0,
                        ttl_days INTEGER DEFAULT NULL,
                        version INTEGER NOT NULL DEFAULT 1,
                        source TEXT NOT NULL DEFAULT 'manual',
                        confidence REAL NOT NULL DEFAULT 1.0 CHECK(confidence >= 0.0 AND confidence <= 1.0),
                        deleted_at TEXT DEFAULT NULL,
                        created_at TEXT NOT NULL,
                        updated_at TEXT NOT NULL,
                        UNIQUE(namespace, topic)
                    )
                    """,
                    "CREATE INDEX IF NOT EXISTS idx_memories_ns_hits ON memories(namespace, access_count DESC, updated_at DESC)",
                    "CREATE INDEX IF NOT EXISTS idx_memories_deleted ON memories(deleted_at)",
                    """
                    CREATE VIRTUAL TABLE IF NOT EXISTS memories_fts USING fts5(
                        topic,
                        content,
                        tags,
                        namespace,
                        content='memories',
                        content_rowid='id',
                        tokenize='unicode61 remove_diacritics 2'
                    )
                    """,
                    """
                    CREATE TRIGGER IF NOT EXISTS memories_ai AFTER INSERT ON memories WHEN new.deleted_at IS NULL BEGIN
                        INSERT INTO memories_fts(rowid, topic, content, tags, namespace)
                        VALUES (new.id, new.topic, new.content, new.tags, new.namespace);
                    END
                    """,
                    """
                    CREATE TRIGGER IF NOT EXISTS memories_ad AFTER DELETE ON memories WHEN old.deleted_at IS NULL BEGIN
                        INSERT INTO memories_fts(memories_fts, rowid, topic, content, tags, namespace)
                        VALUES ('delete', old.id, old.topic, old.content, old.tags, old.namespace);
                    END
                    """,
                    """
                    -- FTS5 External Content State Machine Guard:
                    -- Em tabelas FTS5 external content (content='memories'), o comando 'delete' NAO e idempotente.
                    -- Executar 'delete' para um rowid ja removido em soft-delete corrompe a B-Tree invertida do FTS5
                    -- com SQLITE_CORRUPT ('database disk image is malformed').
                    -- Portanto, 'WHERE old.deleted_at IS NULL' e uma guarda de estado estritamente obrigatoria.
                    CREATE TRIGGER IF NOT EXISTS memories_au AFTER UPDATE OF topic, content, tags, namespace, deleted_at ON memories BEGIN
                        INSERT INTO memories_fts(memories_fts, rowid, topic, content, tags, namespace)
                        SELECT 'delete', old.id, old.topic, old.content, old.tags, old.namespace
                        WHERE old.deleted_at IS NULL;

                        INSERT INTO memories_fts(rowid, topic, content, tags, namespace)
                        SELECT new.id, new.topic, new.content, new.tags, new.namespace
                        WHERE new.deleted_at IS NULL;
                    END
                    """,
                ]
                for stmt in ddl_initial:
                    conn.execute(stmt)
            else:
                table_sql = (row[0] or "").lower()
                cols = [col[1] for col in conn.execute("PRAGMA table_info(memories)").fetchall()]
                current_ver = conn.execute("PRAGMA user_version;").fetchone()[0]
                is_v1 = "'playbook'" not in table_sql or "ttl_days" not in cols or current_ver < 2

                if is_v1:
                    conn.execute("PRAGMA foreign_keys=OFF;")
                    v1_upgrade_stmts = [
                        """
                        CREATE TABLE memories_new (
                            id INTEGER PRIMARY KEY AUTOINCREMENT,
                            namespace TEXT NOT NULL,
                            kind TEXT NOT NULL CHECK(kind IN ('fact', 'learning', 'behavior', 'decision', 'invariant', 'playbook')),
                            topic TEXT NOT NULL,
                            content TEXT NOT NULL,
                            tags TEXT DEFAULT '',
                            access_count INTEGER DEFAULT 0,
                            ttl_days INTEGER DEFAULT NULL,
                            version INTEGER NOT NULL DEFAULT 1,
                            source TEXT NOT NULL DEFAULT 'manual',
                            confidence REAL NOT NULL DEFAULT 1.0 CHECK(confidence >= 0.0 AND confidence <= 1.0),
                            deleted_at TEXT DEFAULT NULL,
                            created_at TEXT NOT NULL,
                            updated_at TEXT NOT NULL,
                            UNIQUE(namespace, topic)
                        )
                        """,
                        """
                        INSERT INTO memories_new (id, namespace, kind, topic, content, tags, access_count, created_at, updated_at)
                        SELECT id, namespace, kind, topic, content, tags, access_count, created_at, updated_at FROM memories
                        """,
                        "DROP TRIGGER IF EXISTS memories_ai",
                        "DROP TRIGGER IF EXISTS memories_ad",
                        "DROP TRIGGER IF EXISTS memories_au",
                        "DROP TABLE memories",
                        "ALTER TABLE memories_new RENAME TO memories",
                    ]
                    for stmt in v1_upgrade_stmts:
                        conn.execute(stmt)
                    conn.execute("PRAGMA foreign_keys=ON;")

                cols = [col[1] for col in conn.execute("PRAGMA table_info(memories)").fetchall()]
                if "ttl_days" not in cols:
                    conn.execute("ALTER TABLE memories ADD COLUMN ttl_days INTEGER DEFAULT NULL;")
                if "version" not in cols:
                    conn.execute("ALTER TABLE memories ADD COLUMN version INTEGER NOT NULL DEFAULT 1;")
                if "source" not in cols:
                    conn.execute("ALTER TABLE memories ADD COLUMN source TEXT NOT NULL DEFAULT 'manual';")
                if "confidence" not in cols:
                    conn.execute("ALTER TABLE memories ADD COLUMN confidence REAL NOT NULL DEFAULT 1.0;")
                if "deleted_at" not in cols:
                    conn.execute("ALTER TABLE memories ADD COLUMN deleted_at TEXT DEFAULT NULL;")

                conn.execute("CREATE INDEX IF NOT EXISTS idx_memories_ns_hits ON memories(namespace, access_count DESC, updated_at DESC);")
                conn.execute("CREATE INDEX IF NOT EXISTS idx_memories_deleted ON memories(deleted_at);")

                # Replace triggers with soft-delete-aware triggers and rebuild FTS5 index
                trigger_stmts = [
                    "DROP TRIGGER IF EXISTS memories_ai",
                    "DROP TRIGGER IF EXISTS memories_ad",
                    "DROP TRIGGER IF EXISTS memories_au",
                    """
                    CREATE TRIGGER memories_ai AFTER INSERT ON memories WHEN new.deleted_at IS NULL BEGIN
                        INSERT INTO memories_fts(rowid, topic, content, tags, namespace)
                        VALUES (new.id, new.topic, new.content, new.tags, new.namespace);
                    END
                    """,
                    """
                    CREATE TRIGGER memories_ad AFTER DELETE ON memories WHEN old.deleted_at IS NULL BEGIN
                        INSERT INTO memories_fts(memories_fts, rowid, topic, content, tags, namespace)
                        VALUES ('delete', old.id, old.topic, old.content, old.tags, old.namespace);
                    END
                    """,
                    """
                    -- FTS5 External Content State Machine Guard:
                    -- Em tabelas FTS5 external content (content='memories'), o comando 'delete' NAO e idempotente.
                    -- Executar 'delete' para um rowid ja removido em soft-delete corrompe a B-Tree invertida do FTS5
                    -- com SQLITE_CORRUPT ('database disk image is malformed').
                    -- Portanto, 'WHERE old.deleted_at IS NULL' e uma guarda de estado estritamente obrigatoria.
                    CREATE TRIGGER memories_au AFTER UPDATE OF topic, content, tags, namespace, deleted_at ON memories BEGIN
                        INSERT INTO memories_fts(memories_fts, rowid, topic, content, tags, namespace)
                        SELECT 'delete', old.id, old.topic, old.content, old.tags, old.namespace
                        WHERE old.deleted_at IS NULL;

                        INSERT INTO memories_fts(rowid, topic, content, tags, namespace)
                        SELECT new.id, new.topic, new.content, new.tags, new.namespace
                        WHERE new.deleted_at IS NULL;
                    END
                    """,
                    "INSERT INTO memories_fts(memories_fts) VALUES('rebuild')",
                ]
                for stmt in trigger_stmts:
                    conn.execute(stmt)

            # 3. Memory history table and auxiliary structures
            auxiliary_ddl = [
                """
                CREATE TABLE IF NOT EXISTS memory_history (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    memory_id INTEGER NOT NULL,
                    namespace TEXT NOT NULL,
                    kind TEXT NOT NULL,
                    topic TEXT NOT NULL,
                    content TEXT NOT NULL,
                    tags TEXT NOT NULL,
                    version INTEGER NOT NULL,
                    source TEXT NOT NULL,
                    confidence REAL NOT NULL,
                    archived_at TEXT NOT NULL
                )
                """,
                "CREATE INDEX IF NOT EXISTS idx_history_mem_id ON memory_history(memory_id)",
                "CREATE INDEX IF NOT EXISTS idx_history_ns_topic ON memory_history(namespace, topic)",
                """
                CREATE TABLE IF NOT EXISTS memory_edges (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    source_id INTEGER NOT NULL,
                    target_id INTEGER NOT NULL,
                    relation TEXT NOT NULL,
                    created_at TEXT NOT NULL,
                    UNIQUE(source_id, target_id, relation),
                    FOREIGN KEY(source_id) REFERENCES memories(id) ON DELETE CASCADE,
                    FOREIGN KEY(target_id) REFERENCES memories(id) ON DELETE CASCADE
                )
                """,
                "CREATE INDEX IF NOT EXISTS idx_edges_source ON memory_edges(source_id)",
                "CREATE INDEX IF NOT EXISTS idx_edges_target ON memory_edges(target_id)",
                """
                CREATE TABLE IF NOT EXISTS prospective_tasks (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    namespace TEXT NOT NULL,
                    trigger_cond TEXT NOT NULL,
                    action TEXT NOT NULL,
                    status TEXT NOT NULL DEFAULT 'pending' CHECK(status IN ('pending', 'done')),
                    created_at TEXT NOT NULL,
                    completed_at TEXT
                )
                """,
                "CREATE INDEX IF NOT EXISTS idx_prospective_ns_status ON prospective_tasks(namespace, status)",
                """
                CREATE TABLE IF NOT EXISTS synonyms (
                    term TEXT PRIMARY KEY,
                    expanded TEXT NOT NULL
                )
                """,
            ]
            for stmt in auxiliary_ddl:
                conn.execute(stmt)

            # 4. Populate default synonyms if empty
            syn_count = conn.execute("SELECT COUNT(*) FROM synonyms").fetchone()[0]
            if syn_count == 0:
                for group in DEFAULT_SYNONYM_GROUPS:
                    for item in group:
                        term = item.lower()
                        expanded = ", ".join(sorted(other.lower() for other in group if other != item))
                        conn.execute(
                            "INSERT OR IGNORE INTO synonyms (term, expanded) VALUES (?, ?)",
                            (term, expanded),
                        )

            # 5. Populate formal migrations log
            conn.execute(
                "INSERT OR IGNORE INTO schema_migrations (version, applied_at, description) VALUES (1, ?, ?)",
                (ts, "Initial L2 schema (memories, FTS5)"),
            )
            conn.execute(
                "INSERT OR IGNORE INTO schema_migrations (version, applied_at, description) VALUES (2, ?, ?)",
                (ts, "Graph edges, prospective tasks, dynamic synonyms"),
            )
            conn.execute(
                "INSERT OR IGNORE INTO schema_migrations (version, applied_at, description) VALUES (3, ?, ?)",
                (ts, "Versioning, provenance (source, confidence), soft-delete, memory history and schema_migrations"),
            )

            conn.execute(f"PRAGMA user_version = {SCHEMA_VERSION};")

    @staticmethod
    def _row_to_record(r: sqlite3.Row, score: float = 0.0) -> MemoryRecord:
        keys = r.keys()
        return MemoryRecord(
            id=r["id"],
            namespace=r["namespace"],
            kind=r["kind"],
            topic=r["topic"],
            content=r["content"],
            tags=r["tags"] or "",
            access_count=r["access_count"],
            ttl_days=r["ttl_days"],
            created_at=r["created_at"] if "created_at" in keys else r["updated_at"],
            updated_at=r["updated_at"],
            version=r["version"] if "version" in keys else 1,
            source=r["source"] if "source" in keys else "manual",
            confidence=float(r["confidence"]) if "confidence" in keys else 1.0,
            deleted_at=r["deleted_at"] if "deleted_at" in keys else None,
            score=score,
        )

    def initialize(self, foundational_records: Sequence[tuple[str, str, str, str, str]], ts: str) -> None:
        conn = self._get_conn()
        self._ensure_schema(conn)
        with immediate_transaction(conn):
            for ns, kind, topic, content, tags in foundational_records:
                conn.execute(
                    """
                    INSERT OR IGNORE INTO memories (namespace, kind, topic, content, tags, access_count, ttl_days, version, source, confidence, deleted_at, created_at, updated_at)
                    VALUES (?, ?, ?, ?, ?, 0, NULL, 1, 'manual', 1.0, NULL, ?, ?)
                    """,
                    (ns, kind, topic, content, tags, ts, ts),
                )

    def upsert(
        self,
        namespace: str,
        kind: str,
        topic: str,
        content: str,
        tags: str,
        ttl_days: int | None,
        ts: str,
        source: str = "manual",
        confidence: float = 1.0,
    ) -> None:
        conn = self._get_conn()
        with immediate_transaction(conn):
            existing = conn.execute(
                "SELECT * FROM memories WHERE namespace = ? AND topic = ?",
                (namespace, topic),
            ).fetchone()

            if existing is None:
                conn.execute(
                    """
                    INSERT INTO memories (namespace, kind, topic, content, tags, access_count, ttl_days, version, source, confidence, deleted_at, created_at, updated_at)
                    VALUES (?, ?, ?, ?, ?, 0, ?, 1, ?, ?, NULL, ?, ?)
                    """,
                    (namespace, kind, topic, content, tags, ttl_days, source, confidence, ts, ts),
                )
            else:
                # Archive previous active/soft-deleted state into memory_history
                conn.execute(
                    """
                    INSERT INTO memory_history (memory_id, namespace, kind, topic, content, tags, version, source, confidence, archived_at)
                    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                    """,
                    (
                        existing["id"],
                        existing["namespace"],
                        existing["kind"],
                        existing["topic"],
                        existing["content"],
                        existing["tags"] or "",
                        existing["version"],
                        existing["source"],
                        existing["confidence"],
                        ts,
                    ),
                )
                new_version = existing["version"] + 1
                conn.execute(
                    """
                    UPDATE memories
                    SET kind = ?,
                        content = ?,
                        tags = ?,
                        ttl_days = ?,
                        version = ?,
                        source = ?,
                        confidence = ?,
                        deleted_at = NULL,
                        updated_at = ?
                    WHERE id = ?
                    """,
                    (kind, content, tags, ttl_days, new_version, source, confidence, ts, existing["id"]),
                )

    def verify_freshness(self, namespace: str, topic: str, new_ttl: int | None, update_ttl: bool, ts: str) -> int | None:
        conn = self._get_conn()
        row = conn.execute(
            "SELECT id, ttl_days FROM memories WHERE namespace = ? AND topic = ? AND deleted_at IS NULL",
            (namespace, topic),
        ).fetchone()
        if not row:
            raise ResourceNotFoundError(f"Active memory not found: [{namespace}] topic='{topic}'")

        effective_ttl = new_ttl if update_ttl else row["ttl_days"]
        with immediate_transaction(conn):
            conn.execute(
                "UPDATE memories SET updated_at = ?, ttl_days = ? WHERE id = ?",
                (ts, effective_ttl, row["id"]),
            )
        return effective_ttl

    def get_by_topic(self, namespace: str, topic: str, increment_hit: bool = True) -> tuple[MemoryRecord, Sequence[SemanticEdge]]:
        conn = self._get_conn()
        row = conn.execute(
            "SELECT * FROM memories WHERE namespace = ? AND topic = ? AND deleted_at IS NULL",
            (namespace, topic),
        ).fetchone()
        if not row:
            raise ResourceNotFoundError(f"Not found: [{namespace}] topic='{topic}'")

        if increment_hit:
            with immediate_transaction(conn):
                conn.execute("UPDATE memories SET access_count = access_count + 1 WHERE id = ?", (row["id"],))

        rec = self._row_to_record(row)
        if increment_hit:
            rec = MemoryRecord(
                id=rec.id,
                namespace=rec.namespace,
                kind=rec.kind,
                topic=rec.topic,
                content=rec.content,
                tags=rec.tags,
                access_count=rec.access_count + 1,
                ttl_days=rec.ttl_days,
                created_at=rec.created_at,
                updated_at=rec.updated_at,
                version=rec.version,
                source=rec.source,
                confidence=rec.confidence,
                deleted_at=rec.deleted_at,
            )

        out_edges = conn.execute(
            """
            SELECT e.relation, m.namespace, m.topic
            FROM memory_edges e
            JOIN memories m ON e.target_id = m.id
            WHERE e.source_id = ? AND m.deleted_at IS NULL
            ORDER BY e.relation, m.namespace, m.topic
            """,
            (row["id"],),
        ).fetchall()
        in_edges = conn.execute(
            """
            SELECT e.relation, m.namespace, m.topic
            FROM memory_edges e
            JOIN memories m ON e.source_id = m.id
            WHERE e.target_id = ? AND m.deleted_at IS NULL
            ORDER BY e.relation, m.namespace, m.topic
            """,
            (row["id"],),
        ).fetchall()

        edges: list[SemanticEdge] = [
            SemanticEdge(relation=e["relation"], namespace=e["namespace"], topic=e["topic"], direction="out")
            for e in out_edges
        ]
        edges.extend(
            SemanticEdge(relation=e["relation"], namespace=e["namespace"], topic=e["topic"], direction="in")
            for e in in_edges
        )
        return rec, edges

    def search_fts(self, fts_query: str, namespace: str | None, limit: int, prioritize_episodic: bool = False) -> Sequence[MemoryRecord]:
        conn = self._get_conn()
        # memories_fts columns: topic (5.0), content (1.0), tags (3.0), namespace (0.5)
        # Multiply relevance by m.confidence to score higher-confidence memories accordingly.
        # Filter strictly for deleted_at IS NULL.
        sql = """
            SELECT m.id, m.namespace, m.kind, m.topic, m.content, m.tags, m.access_count, m.ttl_days, m.created_at, m.updated_at,
                   m.version, m.source, m.confidence, m.deleted_at,
                   (MAX(0.0001, -1.0 * bm25(memories_fts, 5.0, 1.0, 3.0, 0.5))
                    * (1.0 + 0.15 * MIN(m.access_count, 30))
                    * m.confidence
                    / (1.0 + 0.02 * MAX(0.0, julianday('now') - julianday(m.updated_at)))) AS relevance_score,
                   CASE WHEN m.kind IN ('learning', 'playbook') THEN 1 ELSE 0 END AS episodic_boost
            FROM memories_fts
            JOIN memories m ON m.id = memories_fts.rowid
            WHERE memories_fts MATCH ? AND m.deleted_at IS NULL
        """
        params: list[object] = [fts_query]
        if namespace:
            sql += " AND m.namespace = ?"
            params.append(namespace)

        if prioritize_episodic:
            sql += " ORDER BY episodic_boost DESC, relevance_score DESC, m.updated_at DESC LIMIT ?"
        else:
            sql += " ORDER BY relevance_score DESC, m.updated_at DESC LIMIT ?"
        params.append(limit)

        rows = conn.execute(sql, params).fetchall()
        if not rows:
            return []

        ids = [(r["id"],) for r in rows]
        with immediate_transaction(conn):
            conn.executemany("UPDATE memories SET access_count = access_count + 1 WHERE id = ?", ids)

        return [
            MemoryRecord(
                id=r["id"],
                namespace=r["namespace"],
                kind=r["kind"],
                topic=r["topic"],
                content=r["content"],
                tags=r["tags"] or "",
                access_count=r["access_count"] + 1,
                ttl_days=r["ttl_days"],
                created_at=r["created_at"],
                updated_at=r["updated_at"],
                version=r["version"],
                source=r["source"],
                confidence=float(r["confidence"]),
                deleted_at=r["deleted_at"],
                score=float(r["relevance_score"]),
            )
            for r in rows
        ]

    def list_records(self, namespace: str | None) -> Sequence[MemoryRecord]:
        conn = self._get_conn()
        if namespace:
            rows = conn.execute(
                "SELECT * FROM memories WHERE namespace = ? AND deleted_at IS NULL ORDER BY namespace, topic",
                (namespace,),
            ).fetchall()
        else:
            rows = conn.execute("SELECT * FROM memories WHERE deleted_at IS NULL ORDER BY namespace, topic").fetchall()
        return [self._row_to_record(r) for r in rows]

    def delete_record(self, namespace: str, topic: str, hard: bool = False, ts: str = "") -> bool:
        conn = self._get_conn()
        with immediate_transaction(conn):
            existing = conn.execute(
                "SELECT * FROM memories WHERE namespace = ? AND topic = ?",
                (namespace, topic),
            ).fetchone()
            if existing is None:
                return False

            if hard:
                conn.execute("DELETE FROM memories WHERE id = ?", (existing["id"],))
                return True
            else:
                if existing["deleted_at"] is not None:
                    return False  # Already soft-deleted

                # Archive version before soft-delete
                conn.execute(
                    """
                    INSERT INTO memory_history (memory_id, namespace, kind, topic, content, tags, version, source, confidence, archived_at)
                    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                    """,
                    (
                        existing["id"],
                        existing["namespace"],
                        existing["kind"],
                        existing["topic"],
                        existing["content"],
                        existing["tags"] or "",
                        existing["version"],
                        existing["source"],
                        existing["confidence"],
                        ts,
                    ),
                )
                conn.execute("UPDATE memories SET deleted_at = ? WHERE id = ?", (ts, existing["id"]))
                return True

    def restore_record(self, namespace: str, topic: str, ts: str) -> bool:
        conn = self._get_conn()
        with immediate_transaction(conn):
            existing = conn.execute(
                "SELECT * FROM memories WHERE namespace = ? AND topic = ?",
                (namespace, topic),
            ).fetchone()
            if existing is None or existing["deleted_at"] is None:
                return False

            conn.execute("UPDATE memories SET deleted_at = NULL, updated_at = ? WHERE id = ?", (ts, existing["id"]))
            return True

    def get_history(self, namespace: str, topic: str) -> tuple[MemoryRecord | None, Sequence[MemoryHistoryRecord]]:
        conn = self._get_conn()
        row = conn.execute(
            "SELECT * FROM memories WHERE namespace = ? AND topic = ?",
            (namespace, topic),
        ).fetchone()
        current = self._row_to_record(row) if row else None

        if row:
            hist_rows = conn.execute(
                "SELECT * FROM memory_history WHERE memory_id = ? ORDER BY version ASC, id ASC",
                (row["id"],),
            ).fetchall()
        else:
            hist_rows = conn.execute(
                "SELECT * FROM memory_history WHERE namespace = ? AND topic = ? ORDER BY version ASC, id ASC",
                (namespace, topic),
            ).fetchall()

        history = [
            MemoryHistoryRecord(
                id=r["id"],
                memory_id=r["memory_id"],
                namespace=r["namespace"],
                kind=r["kind"],
                topic=r["topic"],
                content=r["content"],
                tags=r["tags"] or "",
                version=r["version"],
                source=r["source"],
                confidence=float(r["confidence"]),
                archived_at=r["archived_at"],
            )
            for r in hist_rows
        ]
        return current, history

    def hot_backup(self, dest_path: str) -> str:
        conn = self._get_conn()
        os.makedirs(os.path.dirname(os.path.abspath(dest_path)), exist_ok=True)
        dest_conn = sqlite3.connect(dest_path)
        try:
            conn.backup(dest_conn)
        finally:
            dest_conn.close()
        return dest_path

    def get_promotion_candidates(self, namespace: str | None, by: str, min_hits: int, limit: int) -> Sequence[MemoryRecord]:
        conn = self._get_conn()
        order_by = "m.access_count DESC, m.updated_at DESC" if by == "hits" else "m.updated_at DESC, m.access_count DESC"
        sql = "SELECT * FROM memories m WHERE m.access_count >= ? AND m.deleted_at IS NULL"
        params: list[object] = [min_hits]
        if namespace:
            sql += " AND m.namespace = ?"
            params.append(namespace)
        sql += f" ORDER BY {order_by} LIMIT ?"
        params.append(limit)
        rows = conn.execute(sql, params).fetchall()
        return [self._row_to_record(r) for r in rows]

    def link_topics(self, src_ns: str, src_topic: str, relation: str, dst_ns: str, dst_topic: str, ts: str) -> None:
        conn = self._get_conn()
        src_row = conn.execute(
            "SELECT id FROM memories WHERE namespace = ? AND topic = ? AND deleted_at IS NULL",
            (src_ns, src_topic),
        ).fetchone()
        if not src_row:
            raise ResourceNotFoundError(f"Active source memory not found: [{src_ns}] topic='{src_topic}'")
        dst_row = conn.execute(
            "SELECT id FROM memories WHERE namespace = ? AND topic = ? AND deleted_at IS NULL",
            (dst_ns, dst_topic),
        ).fetchone()
        if not dst_row:
            raise ResourceNotFoundError(f"Active target memory not found: [{dst_ns}] topic='{dst_topic}'")

        with immediate_transaction(conn):
            conn.execute(
                """
                INSERT OR IGNORE INTO memory_edges (source_id, target_id, relation, created_at)
                VALUES (?, ?, ?, ?)
                """,
                (src_row["id"], dst_row["id"], relation, ts),
            )

    def defer_task(self, namespace: str, trigger_cond: str, action: str, ts: str) -> int:
        conn = self._get_conn()
        with immediate_transaction(conn):
            cur = conn.execute(
                """
                INSERT INTO prospective_tasks (namespace, trigger_cond, action, status, created_at)
                VALUES (?, ?, ?, 'pending', ?)
                """,
                (namespace, trigger_cond, action, ts),
            )
        return int(cur.lastrowid)

    def list_due_tasks(self, namespaces: Sequence[str] | None = None) -> Sequence[ProspectiveTask]:
        conn = self._get_conn()
        if namespaces is not None:
            if not namespaces:
                return []
            placeholders = ",".join("?" * len(namespaces))
            rows = conn.execute(
                f"SELECT id, namespace, trigger_cond, action, status, created_at, completed_at FROM prospective_tasks WHERE status = 'pending' AND namespace IN ({placeholders}) ORDER BY id",
                list(namespaces),
            ).fetchall()
        else:
            rows = conn.execute(
                "SELECT id, namespace, trigger_cond, action, status, created_at, completed_at FROM prospective_tasks WHERE status = 'pending' ORDER BY id"
            ).fetchall()
        return [
            ProspectiveTask(
                id=r["id"],
                namespace=r["namespace"],
                trigger_cond=r["trigger_cond"],
                action=r["action"],
                status=r["status"],
                created_at=r["created_at"],
                completed_at=r["completed_at"],
            )
            for r in rows
        ]

    def complete_task(self, task_id: int, ts: str) -> bool:
        conn = self._get_conn()
        with immediate_transaction(conn):
            cur = conn.execute(
                "UPDATE prospective_tasks SET status = 'done', completed_at = ? WHERE id = ? AND status = 'pending'",
                (ts, task_id),
            )
        return cur.rowcount > 0

    def get_synonyms(self) -> dict[str, list[str]]:
        conn = self._get_conn()
        syn_map: dict[str, list[str]] = {}
        rows = conn.execute("SELECT term, expanded FROM synonyms ORDER BY term").fetchall()
        for r in rows:
            term = r["term"].strip().lower()
            items = [s.strip().lower() for s in r["expanded"].split(",") if s.strip()]
            if items:
                syn_map[term] = items
        return syn_map

    def upsert_synonym(self, term: str, expanded: str) -> None:
        conn = self._get_conn()
        with immediate_transaction(conn):
            conn.execute(
                "INSERT INTO synonyms (term, expanded) VALUES (?, ?) ON CONFLICT(term) DO UPDATE SET expanded = excluded.expanded",
                (term, expanded),
            )

    def get_all_for_export(self, namespace: str | None) -> Sequence[tuple[MemoryRecord, Sequence[SemanticEdge], Sequence[SemanticEdge]]]:
        conn = self._get_conn()
        records = self.list_records(namespace)
        results: list[tuple[MemoryRecord, Sequence[SemanticEdge], Sequence[SemanticEdge]]] = []
        for rec in records:
            out_rows = conn.execute(
                """
                SELECT e.relation, m.namespace, m.topic
                FROM memory_edges e
                JOIN memories m ON e.target_id = m.id
                WHERE e.source_id = ? AND m.deleted_at IS NULL
                ORDER BY e.relation, m.namespace, m.topic
                """,
                (rec.id,),
            ).fetchall()
            in_rows = conn.execute(
                """
                SELECT e.relation, m.namespace, m.topic
                FROM memory_edges e
                JOIN memories m ON e.source_id = m.id
                WHERE e.target_id = ? AND m.deleted_at IS NULL
                ORDER BY e.relation, m.namespace, m.topic
                """,
                (rec.id,),
            ).fetchall()
            out_edges = [SemanticEdge(e["relation"], e["namespace"], e["topic"], "out") for e in out_rows]
            in_edges = [SemanticEdge(e["relation"], e["namespace"], e["topic"], "in") for e in in_rows]
            results.append((rec, out_edges, in_edges))
        return results

    def bulk_import(self, docs: Sequence[WikiDocument], default_ts: str) -> tuple[int, int]:
        conn = self._get_conn()
        restored_links = 0
        with immediate_transaction(conn):
            for d in docs:
                c_at = d.created_at or default_ts
                u_at = d.updated_at or default_ts
                existing = conn.execute(
                    "SELECT id, namespace, kind, topic, content, tags, version, source, confidence FROM memories WHERE namespace = ? AND topic = ?",
                    (d.namespace, d.topic),
                ).fetchone()

                if existing is None:
                    conn.execute(
                        """
                        INSERT INTO memories (namespace, kind, topic, content, tags, access_count, ttl_days, version, source, confidence, deleted_at, created_at, updated_at)
                        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, NULL, ?, ?)
                        """,
                        (d.namespace, d.kind, d.topic, d.body, d.tags, d.access_count, d.ttl_days, d.version, d.source, d.confidence, c_at, u_at),
                    )
                else:
                    # Archive snapshot before overwriting
                    conn.execute(
                        """
                        INSERT INTO memory_history (memory_id, namespace, kind, topic, content, tags, version, source, confidence, archived_at)
                        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                        """,
                        (
                            existing["id"],
                            existing["namespace"],
                            existing["kind"],
                            existing["topic"],
                            existing["content"],
                            existing["tags"] or "",
                            existing["version"],
                            existing["source"],
                            existing["confidence"],
                            u_at,
                        ),
                    )
                    new_version = existing["version"] + 1
                    conn.execute(
                        """
                        UPDATE memories
                        SET kind = ?,
                            content = ?,
                            tags = ?,
                            access_count = ?,
                            ttl_days = ?,
                            version = ?,
                            source = ?,
                            confidence = ?,
                            deleted_at = NULL,
                            updated_at = ?
                        WHERE id = ?
                        """,
                        (d.kind, d.body, d.tags, d.access_count, d.ttl_days, new_version, d.source, d.confidence, u_at, existing["id"]),
                    )

            for d in docs:
                for link_str in d.links:
                    if "->" not in link_str:
                        continue
                    rel_part, target_part = link_str.split("->", 1)
                    rel = rel_part.strip().upper()
                    target_clean = target_part.strip()
                    if ":" not in target_clean:
                        continue
                    dst_ns, dst_topic = target_clean.split(":", 1)
                    src_row = conn.execute("SELECT id FROM memories WHERE namespace = ? AND topic = ?", (d.namespace, d.topic)).fetchone()
                    dst_row = conn.execute("SELECT id FROM memories WHERE namespace = ? AND topic = ?", (dst_ns, dst_topic)).fetchone()
                    if src_row and dst_row:
                        cur = conn.execute(
                            """
                            INSERT OR IGNORE INTO memory_edges (source_id, target_id, relation, created_at)
                            VALUES (?, ?, ?, ?)
                            """,
                            (src_row["id"], dst_row["id"], rel, default_ts),
                        )
                        if cur.rowcount:
                            restored_links += 1

        return len(docs), restored_links

    def compute_stats(self, stale_checker: Callable[[str, int | None], str | None]) -> StorageStats:
        conn = self._get_conn()
        ns_rows = conn.execute(
            """
            SELECT namespace, COUNT(*) as cnt, SUM(access_count) as hits, SUM(LENGTH(content)) as bytes
            FROM memories
            WHERE deleted_at IS NULL
            GROUP BY namespace
            ORDER BY namespace
            """
        ).fetchall()
        ns_stats = [
            NamespaceStat(
                namespace=r["namespace"],
                count=r["cnt"],
                hits=r["hits"] or 0,
                total_bytes=r["bytes"] or 0,
            )
            for r in ns_rows
        ]

        monitored = conn.execute("SELECT updated_at, ttl_days FROM memories WHERE ttl_days IS NOT NULL AND deleted_at IS NULL").fetchall()
        stale_cnt = sum(1 for m in monitored if stale_checker(m["updated_at"], m["ttl_days"]) is not None)

        pending_cnt = conn.execute("SELECT COUNT(*) FROM prospective_tasks WHERE status = 'pending'").fetchone()[0]
        total_tasks_cnt = conn.execute("SELECT COUNT(*) FROM prospective_tasks").fetchone()[0]
        edges_cnt = conn.execute("SELECT COUNT(*) FROM memory_edges").fetchone()[0]
        syn_cnt = conn.execute("SELECT COUNT(*) FROM synonyms").fetchone()[0]
        soft_del_cnt = conn.execute("SELECT COUNT(*) FROM memories WHERE deleted_at IS NOT NULL").fetchone()[0]
        hist_cnt = conn.execute("SELECT COUNT(*) FROM memory_history").fetchone()[0]

        top_rows = conn.execute(
            "SELECT * FROM memories WHERE deleted_at IS NULL ORDER BY access_count DESC, updated_at DESC LIMIT 5"
        ).fetchall()
        top_records = [self._row_to_record(r) for r in top_rows]

        return StorageStats(
            namespaces=ns_stats,
            stale_count=stale_cnt,
            ttl_monitored_count=len(monitored),
            pending_tasks_count=pending_cnt,
            total_tasks_count=total_tasks_cnt,
            edges_count=edges_cnt,
            synonyms_count=syn_cnt,
            soft_deleted_count=soft_del_cnt,
            history_versions_count=hist_cnt,
            top_records=top_records,
        )


class MarkdownWikiAdapter:
    @staticmethod
    def _safe_filename(topic: str, used_names: set[str]) -> str:
        slug = re.sub(r"[^a-zA-Z0-9._-]+", "_", topic).strip("_") or "memory"
        candidate = f"{slug}.md"
        if candidate.lower() in used_names:
            short_hash = hashlib.sha256(topic.encode("utf-8")).hexdigest()[:6]
            candidate = f"{slug}_{short_hash}.md"
        used_names.add(candidate.lower())
        return candidate

    @staticmethod
    def parse_inline_array(raw: str) -> list[str]:
        raw = raw.strip()
        if not (raw.startswith("[") and raw.endswith("]")):
            return []
        s = raw[1:-1].strip()
        if not s:
            return []
        items: list[str] = []
        current: list[str] = []
        in_quote: str | None = None
        escaped = False
        for ch in s:
            if escaped:
                current.append(ch)
                escaped = False
            elif ch == "\\":
                escaped = True
            elif in_quote:
                if ch == in_quote:
                    in_quote = None
                else:
                    current.append(ch)
            elif ch in ('"', "'"):
                in_quote = ch
            elif ch == ",":
                val = "".join(current).strip()
                if val:
                    items.append(val)
                current = []
            else:
                current.append(ch)
        val = "".join(current).strip()
        if val:
            items.append(val)
        return items

    @staticmethod
    def parse_multiline_block(mode: str, lines: list[str]) -> str:
        indents = [len(l) - len(l.lstrip()) for l in lines if l.strip()]
        base_indent = min(indents) if indents else 0
        stripped_lines = [l[base_indent:] if len(l) >= base_indent else l.lstrip() for l in lines]
        if mode.startswith("|"):
            return "\n".join(stripped_lines).strip()
        elif mode.startswith(">"):
            return " ".join(stripped_lines).strip()
        return "\n".join(stripped_lines).strip()

    @classmethod
    def parse_frontmatter(cls, fm_text: str) -> WikiDocument:
        doc = WikiDocument(namespace="", topic="")
        links: list[str] = []
        in_links_list = False
        multiline_key: str | None = None
        multiline_mode: str | None = None
        multiline_lines: list[str] = []

        def commit_multiline() -> None:
            nonlocal multiline_key, multiline_mode, multiline_lines
            if multiline_key is not None and multiline_mode is not None:
                val = cls.parse_multiline_block(multiline_mode, multiline_lines)
                if multiline_key == "tags":
                    doc.tags = val
                elif multiline_key == "body" or multiline_key == "content":
                    doc.body = val
                multiline_key = None
                multiline_mode = None
                multiline_lines = []

        for line in fm_text.splitlines():
            if multiline_key is not None:
                if line.startswith((" ", "\t")) or not line.strip():
                    multiline_lines.append(line)
                    continue
                else:
                    commit_multiline()

            if in_links_list:
                stripped_line = line.strip()
                if stripped_line.startswith("- "):
                    link_item = stripped_line[2:].strip().strip("\"'")
                    links.append(link_item)
                    continue
                elif line.startswith((" ", "\t")) and not stripped_line:
                    continue
                else:
                    in_links_list = False

            stripped = line.strip()
            if not stripped or stripped.startswith("#"):
                continue

            match = re.match(r"^([a-zA-Z0-9_-]+)\s*:\s*(.*)$", stripped)
            if not match:
                continue

            key = match.group(1).strip()
            val = match.group(2).strip()

            if val in ("|", "|-", "|+", ">", ">-", ">+"):
                multiline_key = key
                multiline_mode = val
                multiline_lines = []
                continue

            if key == "links":
                if val.startswith("[") and val.endswith("]"):
                    links.extend(cls.parse_inline_array(val))
                elif not val:
                    in_links_list = True
                continue

            if val.startswith("[") and val.endswith("]"):
                array_items = cls.parse_inline_array(val)
                if key == "tags":
                    doc.tags = ", ".join(array_items)
                continue

            if (val.startswith('"') and val.endswith('"')) or (val.startswith("'") and val.endswith("'")):
                val = val[1:-1].replace('\\"', '"').replace("\\'", "'").replace("\\\\", "\\")

            if key == "namespace":
                doc.namespace = val
            elif key == "topic":
                doc.topic = val
            elif key == "kind":
                doc.kind = val if val in VALID_KINDS else "fact"
            elif key == "tags":
                doc.tags = val
            elif key == "access_count":
                try:
                    doc.access_count = int(val)
                except ValueError:
                    doc.access_count = 0
            elif key == "ttl_days":
                if val.lower() in ("null", "none", "", "~"):
                    doc.ttl_days = None
                else:
                    try:
                        doc.ttl_days = int(val)
                    except ValueError:
                        doc.ttl_days = None
            elif key == "version":
                try:
                    doc.version = int(val)
                except ValueError:
                    doc.version = 1
            elif key == "source":
                doc.source = val
            elif key == "confidence":
                try:
                    doc.confidence = float(val)
                except ValueError:
                    doc.confidence = 1.0
            elif key == "created_at":
                doc.created_at = val
            elif key == "updated_at":
                doc.updated_at = val

        commit_multiline()
        doc.links = links
        return doc

    @classmethod
    def export_wiki(
        cls,
        wiki_dir: str,
        items: Sequence[tuple[MemoryRecord, Sequence[SemanticEdge], Sequence[SemanticEdge]]],
        is_full_export: bool,
        now_iso: str,
    ) -> tuple[int, str]:
        os.makedirs(wiki_dir, exist_ok=True)
        grouped_for_index: dict[str, list[dict[str, str]]] = {}
        exported_filepaths: set[str] = set()
        used_names_per_ns: dict[str, set[str]] = {}

        for rec, out_edges, in_edges in items:
            ns_folder = rec.namespace.replace(":", "_")
            ns_dir = os.path.join(wiki_dir, ns_folder)
            os.makedirs(ns_dir, exist_ok=True)

            ns_used = used_names_per_ns.setdefault(rec.namespace, set())
            filename = cls._safe_filename(rec.topic, ns_used)
            filepath = os.path.join(ns_dir, filename)
            exported_filepaths.add(os.path.abspath(filepath))

            if not out_edges:
                links_yaml = "links: []"
            else:
                links_lines = ["links:"]
                for e in out_edges:
                    links_lines.append(f'  - "{e.relation} -> {e.namespace}:{e.topic}"')
                links_yaml = "\n".join(links_lines)

            ttl_yaml = str(rec.ttl_days) if rec.ttl_days is not None else "null"
            clean_tags = rec.tags.replace("\\", "\\\\").replace('"', '\\"')
            clean_topic = rec.topic.replace("\\", "\\\\").replace('"', '\\"')
            clean_ns = rec.namespace.replace("\\", "\\\\").replace('"', '\\"')
            clean_source = rec.source.replace("\\", "\\\\").replace('"', '\\"')

            frontmatter = (
                f"---\n"
                f'namespace: "{clean_ns}"\n'
                f'topic: "{clean_topic}"\n'
                f'kind: "{rec.kind}"\n'
                f"version: {rec.version}\n"
                f'source: "{clean_source}"\n'
                f"confidence: {rec.confidence}\n"
                f'tags: "{clean_tags}"\n'
                f"access_count: {rec.access_count}\n"
                f"ttl_days: {ttl_yaml}\n"
                f'created_at: "{rec.created_at}"\n'
                f'updated_at: "{rec.updated_at}"\n'
                f"{links_yaml}\n"
                f"---"
            )

            semantic_section = ""
            if out_edges or in_edges:
                s_lines = ["\n## 🔗 Links Semânticos"]
                for e in out_edges:
                    s_lines.append(f"- **{e.relation}** -> [[{e.namespace}/{e.topic}]]")
                for e in in_edges:
                    s_lines.append(f"- *referenced by* **{e.relation}** <- [[{e.namespace}/{e.topic}]]")
                semantic_section = "\n" + "\n".join(s_lines)

            file_content = f"{frontmatter}\n\n# {rec.topic}\n\n{rec.content.strip()}{semantic_section}\n"
            with open(filepath, "w", encoding="utf-8") as f:
                f.write(file_content)

            grouped_for_index.setdefault(rec.namespace, []).append({
                "topic": rec.topic,
                "kind": rec.kind,
                "tags": rec.tags,
                "link": f"{ns_folder}/{filename}",
                "summary": DomainPolicy.make_summary(rec.content, rec.tags),
            })

        index_path = os.path.join(wiki_dir, "INDEX.md")
        index_lines = [
            "# 📚 Antigravity Memory Wiki Index",
            "",
            f"> Generated on: {now_iso} | Total memories: {len(items)}",
            "",
            "## Namespaces",
        ]
        for ns, entries in grouped_for_index.items():
            ns_anchor = ns.replace(":", "").replace("_", "-").lower()
            index_lines.append(f"- [`{ns}`](#{ns_anchor}) ({len(entries)} memories)")

        index_lines.append("")
        for ns, entries in grouped_for_index.items():
            index_lines.append(f"## `{ns}`")
            index_lines.append("")
            for it in entries:
                tags_str = f" | tags: {it['tags']}" if it["tags"] else ""
                index_lines.append(f"- [{it['topic']}]({it['link']}) (`{it['kind']}`{tags_str}) — {it['summary']}")
            index_lines.append("")

        with open(index_path, "w", encoding="utf-8") as f:
            f.write("\n".join(index_lines))

        if is_full_export:
            abs_index = os.path.abspath(index_path)
            for root, _, files in os.walk(wiki_dir):
                for file in files:
                    if file.endswith(".md"):
                        fp = os.path.abspath(os.path.join(root, file))
                        if fp not in exported_filepaths and fp != abs_index:
                            try:
                                os.remove(fp)
                            except OSError:
                                pass
            for root, dirs, _ in os.walk(wiki_dir, topdown=False):
                for d in dirs:
                    dp = os.path.join(root, d)
                    try:
                        if not os.listdir(dp):
                            os.rmdir(dp)
                    except OSError:
                        pass

        return len(items), index_path

    @classmethod
    def read_wiki_directory(cls, wiki_dir: str) -> tuple[Sequence[WikiDocument], Sequence[str]]:
        if not os.path.isdir(wiki_dir):
            raise ResourceNotFoundError(f"Import directory not found: {wiki_dir}")

        docs: list[WikiDocument] = []
        warnings: list[str] = []

        for root, _, files in os.walk(wiki_dir):
            for file in sorted(files):
                if not file.endswith(".md") or file == "INDEX.md":
                    continue
                filepath = os.path.join(root, file)
                with open(filepath, "r", encoding="utf-8") as fp:
                    raw_text = fp.read()

                if not raw_text.lstrip().startswith("---"):
                    continue

                parts = re.split(r"^---\s*$", raw_text.lstrip(), maxsplit=2, flags=re.MULTILINE)
                if len(parts) < 3:
                    continue

                fm_text = parts[1]
                body = parts[2]

                doc = cls.parse_frontmatter(fm_text)
                if not doc.namespace or not doc.topic:
                    continue

                try:
                    DomainPolicy.validate_namespace(doc.namespace)
                except DomainValidationError:
                    warnings.append(f"[WARN] Skipping {filepath}: invalid namespace '{doc.namespace}'")
                    continue

                body_no_links = re.split(r"\n##\s+🔗\s+Links Semânticos", body)[0]
                clean_body = re.sub(r"^\s*#\s+[^\n]*\n", "", body_no_links, count=1).strip()
                doc.body = clean_body
                docs.append(doc)

        return docs, warnings


