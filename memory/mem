    def cmd_upsert(self, args: argparse.Namespace) -> None:
        DomainPolicy.validate_namespace(args.namespace)
        DomainPolicy.validate_kind(args.kind)
        ttl_days, _ = DomainPolicy.parse_ttl(args.ttl, args.kind, is_verify=False)
        ts = self._clock.now_iso()
        self._repo.upsert(args.namespace, args.kind, args.topic, args.content, args.tags or "", ttl_days, ts)
        ttl_msg = f" (ttl={ttl_days}d)" if ttl_days is not None else ""
        print(f"[OK] Upserted [{args.namespace}/{args.kind}] topic='{args.topic}'{ttl_msg} at {ts}")

    def cmd_verify(self, args: argparse.Namespace) -> None:
        DomainPolicy.validate_namespace(args.namespace)
        new_ttl, update_ttl = DomainPolicy.parse_ttl(args.ttl, "fact", is_verify=True)
        ts = self._clock.now_iso()
        effective_ttl = self._repo.verify_freshness(args.namespace, args.topic, new_ttl, update_ttl, ts)
        if update_ttl:
            ttl_msg = f" (ttl={effective_ttl}d)" if effective_ttl is not None else " (ttl=infinite)"
        else:
            ttl_msg = f" (ttl={effective_ttl}d)" if effective_ttl is not None else ""
        print(f"[OK] Verified freshness for [{args.namespace}] topic='{args.topic}'{ttl_msg} at {ts}")

    def cmd_search(self, args: argparse.Namespace) -> None:
        if args.ns:
            DomainPolicy.validate_namespace(args.ns)
        syn_map = self._repo.get_synonyms()
        fts_query, syns = DomainPolicy.build_fts_query(args.query, syn_map)
        if not fts_query:
            raise DomainValidationError("Empty search query")

        records = self._repo.search_fts(fts_query, args.ns, args.limit, prioritize_episodic=False)

        if args.ns:
            self._print_prospective_alerts([args.ns])
        else:
            matched_ns = list(dict.fromkeys(r.namespace for r in records))
            self._print_prospective_alerts(matched_ns)

        if not records:
            msg = f"No archival memories matched query='{args.query}'"
            if syns:
                msg += f" (expanded with: {', '.join(syns)})"
            if args.ns:
                msg += f" in namespace='{args.ns}'"
            print(msg)
            return

        if syns:
            print(f"[FTS5 Expanded with synonyms: {', '.join(syns)}]\n")

        for r in records:
            ttl_part = f" | ttl={r.ttl_days}d" if r.ttl_days is not None else ""
            print(f"=== [{r.namespace}/{r.kind}] {r.topic} (tags: {r.tags or '-'} | updated: {r.updated_at}{ttl_part} | hits: {r.access_count}) ===")
            stale_warn = DomainPolicy.check_stale(r.updated_at, r.ttl_days, self._clock)
            if stale_warn:
                print(stale_warn)
            print(r.content)
            print()

    def cmd_get(self, args: argparse.Namespace) -> None:
        DomainPolicy.validate_namespace(args.namespace)
        self._print_prospective_alerts([args.namespace])
        rec, edges = self._repo.get_by_topic(args.namespace, args.topic, increment_hit=True)
        ttl_part = f" | ttl={rec.ttl_days}d" if rec.ttl_days is not None else ""
        print(f"=== [{rec.namespace}/{rec.kind}] {rec.topic} (tags: {rec.tags or '-'} | updated: {rec.updated_at}{ttl_part} | hits: {rec.access_count}) ===")
        stale_warn = DomainPolicy.check_stale(rec.updated_at, rec.ttl_days, self._clock)
        if stale_warn:
            print(stale_warn)
        print(rec.content)

        if edges:
            linked = [
                f"--({e.relation})--> [{e.namespace}:{e.topic}]"
                if e.direction == "out"
                else f"<--({e.relation})-- [{e.namespace}:{e.topic}]"
                for e in edges
            ]
            print(f"\n🔗 Linked: {', '.join(linked)}")

    def cmd_list(self, args: argparse.Namespace) -> None:
        if args.ns:
            DomainPolicy.validate_namespace(args.ns)
        records = self._repo.list_records(args.ns)
        if not records:
            print("(Archival memory is empty)" if not args.ns else f"(No memories in namespace '{args.ns}')")
            return
        for r in records:
            ttl_part = f" | ttl={r.ttl_days}d" if r.ttl_days is not None else ""
            print(f"- [{r.namespace}/{r.kind}] {r.topic} (tags: {r.tags or '-'}{ttl_part}) | updated: {r.updated_at} | hits: {r.access_count}")

    def cmd_delete(self, args: argparse.Namespace) -> None:
        DomainPolicy.validate_namespace(args.namespace)
        deleted = self._repo.delete_record(args.namespace, args.topic)
        if deleted:
            print(f"[OK] Deleted [{args.namespace}] topic='{args.topic}'")
        else:
            print(f"[WARN] Topic not found: [{args.namespace}] topic='{args.topic}'")

    def cmd_promote(self, args: argparse.Namespace) -> None:
        if args.ns:
            DomainPolicy.validate_namespace(args.ns)
        records = self._repo.get_promotion_candidates(args.ns, args.by, args.min_hits, args.limit)
        if not records:
            print("No memories qualify for promotion.")
            return

        print(f"=== Archival Memory Promotion Candidates (Sorted by {args.by}, limit={args.limit}) ===")
        for idx, r in enumerate(records, 1):
            ttl_part = f" | ttl={r.ttl_days}d" if r.ttl_days is not None else ""
            print(f"{idx}. [{r.namespace}/{r.kind}] '{r.topic}' (hits: {r.access_count}{ttl_part} | updated: {r.updated_at})")
        print()

        grouped: dict[str, list[tuple[str, str]]] = {}
        for r in records:
            grouped.setdefault(r.namespace, []).append((r.topic, DomainPolicy.make_summary(r.content, r.tags)))

        print("=== Semantic Directory Snippet (Ready for CORE.md) ===")
        for ns, items in grouped.items():
            formatted_items = ", ".join([f"`{topic}` ({summ})" for topic, summ in items])
            ns_label = f"`{ns}` / `orchestrator`" if ns == "global" else f"`{ns}`"
            print(f"- **{ns_label}:** Tópicos indexados em L2: {formatted_items}")

    def cmd_link(self, args: argparse.Namespace) -> None:
        if ":" not in args.source:
            raise DomainValidationError(f"Source '{args.source}' must be in '<namespace>:<topic>' format")
        if ":" not in args.target:
            raise DomainValidationError(f"Target '{args.target}' must be in '<namespace>:<topic>' format")
        src_ns, src_topic = args.source.split(":", 1)
        dst_ns, dst_topic = args.target.split(":", 1)
        DomainPolicy.validate_namespace(src_ns)
        DomainPolicy.validate_namespace(dst_ns)
        relation = args.relation.strip().upper()
        ts = self._clock.now_iso()
        self._repo.link_topics(src_ns, src_topic, relation, dst_ns, dst_topic, ts)
        print(f"[OK] Linked [{src_ns}:{src_topic}] --({relation})--> [{dst_ns}:{dst_topic}]")

    def cmd_defer(self, args: argparse.Namespace) -> None:
        DomainPolicy.validate_namespace(args.namespace)
        ts = self._clock.now_iso()
        task_id = self._repo.defer_task(args.namespace, args.trigger_cond, args.action, ts)
        print(f"[OK] Deferred prospective task #{task_id} [{args.namespace}]: [{args.trigger_cond}] -> {args.action}")

    def cmd_due(self, args: argparse.Namespace) -> None:
        if args.ns:
            DomainPolicy.validate_namespace(args.ns)
            tasks = self._repo.list_due_tasks([args.ns])
        else:
            tasks = self._repo.list_due_tasks(None)

        if not tasks:
            print("(No pending prospective tasks)" if not args.ns else f"(No pending prospective tasks in namespace '{args.ns}')")
            return
        print(f"=== Pending Prospective Tasks ({len(tasks)}) ===")
        for r in tasks:
            print(f"#{r.id} [{r.namespace}] [{r.trigger_cond}] -> {r.action} (created: {r.created_at})")

    def cmd_done(self, args: argparse.Namespace) -> None:
        ts = self._clock.now_iso()
        if self._repo.complete_task(args.task_id, ts):
            print(f"[OK] Completed prospective task #{args.task_id} at {ts}")
        else:
            print(f"[WARN] Prospective task #{args.task_id} not found or already completed")

    def cmd_syn(self, args: argparse.Namespace) -> None:
        action = getattr(args, "action", None)
        cmd_name = getattr(args, "cmd", "")
        if cmd_name == "syn-list" or action in (None, "list"):
            syn_map = self._repo.get_synonyms()
            if not syn_map:
                print("(No synonyms configured)")
                return
            print(f"=== Dynamic FTS5 Synonyms ({len(syn_map)} terms) ===")
            for term, expanded in syn_map.items():
                print(f"- {term} -> {', '.join(expanded)}")
        elif action == "add":
            if not getattr(args, "term", None) or not getattr(args, "synonyms", None):
                raise DomainValidationError("'syn add' requires <term> and \"<syn1,syn2,...>\"")
            term = args.term.strip().lower()
            expanded_list = [s.strip().lower() for s in args.synonyms.split(",") if s.strip()]
            if not expanded_list:
                raise DomainValidationError("No valid synonyms provided in expanded list")
            expanded_str = ", ".join(expanded_list)
            self._repo.upsert_synonym(term, expanded_str)
            print(f"[OK] Dynamic synonym saved: '{term}' -> '{expanded_str}'")

    def cmd_recall_error(self, args: argparse.Namespace) -> None:
        if args.ns:
            DomainPolicy.validate_namespace(args.ns)
        fts_query, words = DomainPolicy.build_error_fts_query(args.error_snippet)
        if not fts_query:
            raise DomainValidationError("No searchable keywords (length >= 3) found in error snippet")

        records = self._repo.search_fts(fts_query, args.ns, args.limit, prioritize_episodic=True)
        if not records:
            print(f"No error solutions found matching query keywords: {', '.join(words[:10])}")
            return

        print(f"=== Episodic Error Recall (Matched {len(records)} record(s)) ===")
        for r in records:
            ttl_part = f" | ttl={r.ttl_days}d" if r.ttl_days is not None else ""
            print(f"\n=== [{r.namespace}/{r.kind}] {r.topic} (tags: {r.tags or '-'} | updated: {r.updated_at}{ttl_part} | hits: {r.access_count}) ===")
            stale_warn = DomainPolicy.check_stale(r.updated_at, r.ttl_days, self._clock)
            if stale_warn:
                print(stale_warn)
            print(r.content)

    def cmd_check_core(self, _args: argparse.Namespace) -> None:
        with file_lock(self._lock_path):
            if not os.path.exists(self._core_path):
                raise ResourceNotFoundError(f"CORE.md not found at {self._core_path}")
            with open(self._core_path, "r", encoding="utf-8") as f:
                lines = f.readlines()

        line_count = len(lines)
        exceeded = line_count > CORE_MAX_LINES
        status = "EXCEEDED" if exceeded else "OK"
        remaining = CORE_MAX_LINES - line_count

        print("=== CORE.md Working Memory Budget ===")
        print(f"Status: {status} ({line_count}/{CORE_MAX_LINES} lines used, {remaining} lines remaining)")
        print(f"Path: {self._core_path}")

        due_tasks = self._repo.list_due_tasks(None)
        print("\n=== Pending Prospective Tasks ===")
        if not due_tasks:
            print("(No pending prospective tasks)")
        else:
            for t in due_tasks:
                print(f"- #{t.id} [{t.namespace}]: [{t.trigger_cond}] -> {t.action} (created: {t.created_at})")

        if exceeded:
            sys.exit(1)

    def cmd_export_md(self, args: argparse.Namespace) -> None:
        if args.ns:
            DomainPolicy.validate_namespace(args.ns)
        wiki_dir = args.dir if args.dir else os.path.join(self._mem_dir, "wiki")
        items = self._repo.get_all_for_export(args.ns)
        if not items:
            print("No memories to export." if not args.ns else f"No memories to export in namespace '{args.ns}'.")
            return
        count, index_path = MarkdownWikiAdapter.export_wiki(
            wiki_dir=wiki_dir,
            items=items,
            is_full_export=(args.ns is None),
            now_iso=self._clock.now_iso(),
        )
        print(f"[OK] Exported {count} memories to {wiki_dir}")
        print(f"[OK] Generated index at {index_path}")

    def cmd_import_md(self, args: argparse.Namespace) -> None:
        wiki_dir = args.dir if args.dir else os.path.join(self._mem_dir, "wiki")
        docs, warnings = MarkdownWikiAdapter.read_wiki_directory(wiki_dir)
        for w in warnings:
            print(w)
        if not docs:
            print(f"No valid markdown memory files found in {wiki_dir}")
            return
        imported_cnt, links_cnt = self._repo.bulk_import(docs, self._clock.now_iso())
        print(f"[OK] Imported {imported_cnt} memories from {wiki_dir}")
        print(f"[OK] Restored {links_cnt} semantic links into memory_edges")

    def cmd_stats(self, _args: argparse.Namespace) -> None:
        stats = self._repo.compute_stats(lambda u, t: DomainPolicy.check_stale(u, t, self._clock))
        print("=== Archival Memory Statistics (SQLite + FTS5) ===")
        for ns in stats.namespaces:
            print(f"- namespace='{ns.namespace}': {ns.count} records | {ns.hits} total hits | {ns.total_bytes} bytes")

        print(f"\nFreshness / TTL: {stats.stale_count} stale / {stats.ttl_monitored_count} monitored with TTL")
        print(f"Prospective Tasks: {stats.pending_tasks_count} pending / {stats.total_tasks_count} total")
        print(f"Semantic Edges: {stats.edges_count} total connections")
        print(f"Dynamic Synonyms: {stats.synonyms_count} mapped terms")

        if stats.top_records:
            print("\nTop Accessed Records (Promotion Candidates for CORE.md):")
            for t in stats.top_records:
                ttl_part = f" | ttl={t.ttl_days}d" if t.ttl_days is not None else ""
                print(f"  * [{t.namespace}] {t.topic} ({t.access_count} hits{ttl_part})")
        print("\nTip: Run 'mem promote' to generate ready-to-use markdown for CORE.md Semantic Directory.")


def build_parser(controller: MemoryEngineController) -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Antigravity Tier-2 Archival Memory CLI")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_init = sub.add_parser("init", help="Initialize memory database, seed foundational records, and create CORE.md")
    p_init.add_argument("--user", default="[UNCONFIGURED]", help="User display name")
    p_init.add_argument("--lang", default="pt-BR", help="User preferred language")
    p_init.add_argument("--workspace", default="~/workspace", help="Default workspace path")
    p_init.add_argument("--force", action="store_true", help="Force overwrite existing CORE.md from template")
    p_init.set_defaults(func=controller.cmd_init)

    p_search = sub.add_parser("search", help="Search archival memories via FTS5 BM25 with synonym expansion")
    p_search.add_argument("query", help="Search terms or phrases")
    p_search.add_argument("--ns", default=None, help="Filter by namespace")
    p_search.add_argument("--limit", type=int, default=5, help="Result limit (default: 5)")
    p_search.set_defaults(func=controller.cmd_search)

    p_get = sub.add_parser("get", help="Get exact memory record by namespace and topic")
    p_get.add_argument("namespace", help="Namespace")
    p_get.add_argument("topic", help="Topic name")
    p_get.set_defaults(func=controller.cmd_get)

    p_upsert = sub.add_parser("upsert", help="Insert or update an archival memory record")
    p_upsert.add_argument("namespace", help="Namespace (<domain> or proj:<name>)")
    p_upsert.add_argument("kind", help=f"Kind of memory {VALID_KINDS}")
    p_upsert.add_argument("topic", help="Topic identifier")
    p_upsert.add_argument("content", help="Content payload")
    p_upsert.add_argument("tags", nargs="?", default="", help="Comma-separated tags")
    p_upsert.add_argument("--ttl", default=None, help="TTL in days (int, or '0'/'none' for infinite)")
    p_upsert.set_defaults(func=controller.cmd_upsert)

    p_verify = sub.add_parser("verify", help="Verify freshness of a memory record and update its timestamp/TTL")
    p_verify.add_argument("namespace", help="Namespace (<domain> or proj:<name>)")
    p_verify.add_argument("topic", help="Topic identifier")
    p_verify.add_argument("--ttl", default=None, help="Update TTL in days (int, or '0'/'none' for infinite)")
    p_verify.set_defaults(func=controller.cmd_verify)

    p_list = sub.add_parser("list", help="List memory records")
    p_list.add_argument("--ns", default=None, help="Filter by namespace")
    p_list.set_defaults(func=controller.cmd_list)

    p_del = sub.add_parser("delete", help="Delete a memory record")
    p_del.add_argument("namespace", help="Namespace")
    p_del.add_argument("topic", help="Topic name")
    p_del.set_defaults(func=controller.cmd_delete)

    p_promote = sub.add_parser("promote", help="Promote high-traffic or recent L2 topics to CORE.md Semantic Directory")
    p_promote.add_argument("--ns", default=None, help="Filter by namespace")
    p_promote.add_argument("--limit", type=int, default=5, help="Candidate limit (default: 5)")
    p_promote.add_argument("--by", choices=["hits", "recent"], default="hits", help="Sort order")
    p_promote.add_argument("--min-hits", type=int, default=0, help="Minimum access_count filter")
    p_promote.set_defaults(func=controller.cmd_promote)

    p_stats = sub.add_parser("stats", aliases=["status"], help="Show storage and hit statistics")
    p_stats.set_defaults(func=controller.cmd_stats)

    p_link = sub.add_parser("link", help="Link two memories with a semantic relation")
    p_link.add_argument("source", help="Source memory in <namespace>:<topic> format")
    p_link.add_argument("relation", help="Relation name (e.g. RELATES_TO, DEPENDS_ON, SUPERSEDES)")
    p_link.add_argument("target", help="Target memory in <namespace>:<topic> format")
    p_link.set_defaults(func=controller.cmd_link)

    p_defer = sub.add_parser("defer", help="Defer a prospective task/reminder for a namespace")
    p_defer.add_argument("namespace", help="Namespace")
    p_defer.add_argument("trigger_cond", help="Trigger condition or event")
    p_defer.add_argument("action", help="Action to take when triggered")
    p_defer.set_defaults(func=controller.cmd_defer)

    p_due = sub.add_parser("due", help="List pending prospective tasks")
    p_due.add_argument("--ns", default=None, help="Filter by namespace")
    p_due.set_defaults(func=controller.cmd_due)

    p_done = sub.add_parser("done", help="Mark a prospective task as completed")
    p_done.add_argument("task_id", type=int, help="Task ID to complete")
    p_done.set_defaults(func=controller.cmd_done)

    p_syn = sub.add_parser("syn", aliases=["syn-list"], help="Manage dynamic FTS5 synonyms")
    p_syn.add_argument("action", nargs="?", default="list", choices=["list", "add"], help="Action: list or add")
    p_syn.add_argument("term", nargs="?", default=None, help="Term to add")
    p_syn.add_argument("synonyms", nargs="?", default=None, help="Comma-separated synonyms")
    p_syn.set_defaults(func=controller.cmd_syn)

    p_recall = sub.add_parser("recall-error", help="Recall episodic error solutions matching an error snippet")
    p_recall.add_argument("error_snippet", help="Error message, stacktrace or snippet")
    p_recall.add_argument("--ns", default=None, help="Filter by namespace")
    p_recall.add_argument("--limit", type=int, default=5, help="Result limit (default: 5)")
    p_recall.set_defaults(func=controller.cmd_recall_error)

    p_check = sub.add_parser("check-core", help="Check CORE.md line count budget and pending prospective tasks")
    p_check.set_defaults(func=controller.cmd_check_core)

    p_export_md = sub.add_parser("export-md", help="Export archival memories to Markdown Wiki with YAML frontmatter")
    p_export_md.add_argument("dir", nargs="?", default=None, help="Target export directory")
    p_export_md.add_argument("--ns", default=None, help="Filter by namespace")
    p_export_md.set_defaults(func=controller.cmd_export_md)

    p_import_md = sub.add_parser("import-md", help="Import memories and graph links from Markdown Wiki files")
    p_import_md.add_argument("dir", nargs="?", default=None, help="Source import directory")
    p_import_md.set_defaults(func=controller.cmd_import_md)

    return parser


def main() -> None:
    mem_dir = os.path.dirname(os.path.abspath(__file__))
    db_path = os.path.join(mem_dir, "archival.db")
    core_path = os.path.join(mem_dir, "CORE.md")
    core_template_path = os.path.join(mem_dir, "CORE.template.md")

    repo = SqliteMemoryRepository(db_path=db_path)
    clock = UtcClockAdapter()
    controller = MemoryEngineController(
        repo=repo,
        clock=clock,
        mem_dir=mem_dir,
        db_path=db_path,
        core_path=core_path,
        core_template_path=core_template_path,
    )

    parser = build_parser(controller)
    args = parser.parse_args()
    try:
        args.func(args)
    except (DomainValidationError, ResourceNotFoundError) as exc:
        sys.exit(f"Error: {exc}")


if __name__ == "__main__":
    main()
