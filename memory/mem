                VALUES (?, ?, ?, ?, ?, 0, NULL, ?, ?)
                """,
                (ns, kind, topic, content, tags, ts, ts),
            )

    core_created = False
    if not os.path.exists(CORE_PATH) or args.force:
        if os.path.exists(CORE_TEMPLATE_PATH):
            with open(CORE_TEMPLATE_PATH, "r", encoding="utf-8") as f:
                template = f.read()
            rendered = template.replace("{{USER_NAME}}", user_name)
            rendered = rendered.replace("{{USER_LANG}}", user_lang)
            rendered = rendered.replace("{{DEFAULT_WORKSPACE}}", workspace)
            with open(CORE_PATH, "w", encoding="utf-8") as f:
                f.write(rendered)
            core_created = True
        else:
            print(f"[WARN] CORE.template.md not found at {CORE_TEMPLATE_PATH}")

    print(f"[OK] Initialized archival database at {DB_PATH}")
    print("[OK] Seeded foundational L2 records in 'global'")
    if core_created:
        print(f"[OK] Generated {CORE_PATH} from template (user='{user_name}', lang='{user_lang}', workspace='{workspace}')")
    elif os.path.exists(CORE_PATH):
        print(f"[INFO] Existing CORE.md preserved at {CORE_PATH} (use --force to overwrite)")


def cmd_stats(_args: argparse.Namespace) -> None:
    conn = get_conn()
    rows = conn.execute(
        "SELECT namespace, COUNT(*) as cnt, SUM(access_count) as hits, SUM(LENGTH(content)) as bytes FROM memories GROUP BY namespace ORDER BY namespace"
    ).fetchall()
    print("=== Archival Memory Statistics (SQLite + FTS5) ===")
    for r in rows:
        print(f"- namespace='{r['namespace']}': {r['cnt']} records | {r['hits'] or 0} total hits | {r['bytes'] or 0} bytes")

    # Stale / TTL memories count
    all_monitored = conn.execute("SELECT updated_at, ttl_days FROM memories WHERE ttl_days IS NOT NULL").fetchall()
    stale_count = sum(1 for m in all_monitored if check_stale(m["updated_at"], m["ttl_days"]) is not None)
    print(f"\nFreshness / TTL: {stale_count} stale / {len(all_monitored)} monitored with TTL")

    # Prospective tasks count
    pending_tasks = conn.execute("SELECT COUNT(*) FROM prospective_tasks WHERE status = 'pending'").fetchone()[0]
    total_tasks = conn.execute("SELECT COUNT(*) FROM prospective_tasks").fetchone()[0]
    print(f"Prospective Tasks: {pending_tasks} pending / {total_tasks} total")

    # Semantic edges count
    edges_count = conn.execute("SELECT COUNT(*) FROM memory_edges").fetchone()[0]
    print(f"Semantic Edges: {edges_count} total connections")

    # Dynamic synonyms count
    syn_count = conn.execute("SELECT COUNT(*) FROM synonyms").fetchone()[0]
    print(f"Dynamic Synonyms: {syn_count} mapped terms")

    top = conn.execute(
        "SELECT namespace, topic, access_count, ttl_days FROM memories ORDER BY access_count DESC, updated_at DESC LIMIT 5"
    ).fetchall()
    if top:
        print("\nTop Accessed Records (Promotion Candidates for CORE.md):")
        for t in top:
            ttl_part = f" | ttl={t['ttl_days']}d" if t['ttl_days'] is not None else ""
            print(f"  * [{t['namespace']}] {t['topic']} ({t['access_count']} hits{ttl_part})")
    print("\nTip: Run 'mem promote' to generate ready-to-use markdown for CORE.md Semantic Directory.")


def main() -> None:
    parser = argparse.ArgumentParser(description="Antigravity Tier-2 Archival Memory CLI")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_init = sub.add_parser("init", help="Initialize memory database, seed foundational records, and create CORE.md")
    p_init.add_argument("--user", default="[UNCONFIGURED]", help="User display name (default: [UNCONFIGURED])")
    p_init.add_argument("--lang", default="pt-BR", help="User preferred language (default: pt-BR)")
    p_init.add_argument("--workspace", default="~/workspace", help="Default workspace path (default: ~/workspace)")
    p_init.add_argument("--force", action="store_true", help="Force overwrite existing CORE.md from template")
    p_init.set_defaults(func=cmd_init)

    p_search = sub.add_parser("search", help="Search archival memories via FTS5 BM25 with synonym expansion")
    p_search.add_argument("query", help="Search terms or phrases")
    p_search.add_argument("--ns", default=None, help="Filter by namespace (e.g. default, kotlin, rust, proj:my-project)")
    p_search.add_argument("--limit", type=int, default=5, help="Result limit (default: 5)")
    p_search.set_defaults(func=cmd_search)

    p_get = sub.add_parser("get", help="Get exact memory record by namespace and topic")
    p_get.add_argument("namespace", help="Namespace (e.g. default, kotlin, rust, proj:my-project)")
    p_get.add_argument("topic", help="Topic name")
    p_get.set_defaults(func=cmd_get)

    p_upsert = sub.add_parser("upsert", help="Insert or update an archival memory record")
    p_upsert.add_argument("namespace", help="Namespace (<domain> or proj:<name>)")
    p_upsert.add_argument("kind", help=f"Kind of memory {VALID_KINDS}")
    p_upsert.add_argument("topic", help="Topic identifier")
    p_upsert.add_argument("content", help="Content payload")
    p_upsert.add_argument("tags", nargs="?", default="", help="Comma-separated tags")
    p_upsert.add_argument("--ttl", default=None, help="TTL in days (int, or '0'/'none' for infinite)")
    p_upsert.set_defaults(func=cmd_upsert)

    p_verify = sub.add_parser("verify", help="Verify freshness of a memory record and update its timestamp/TTL")
    p_verify.add_argument("namespace", help="Namespace (<domain> or proj:<name>)")
    p_verify.add_argument("topic", help="Topic identifier")
    p_verify.add_argument("--ttl", default=None, help="Update TTL in days (int, or '0'/'none' for infinite)")
    p_verify.set_defaults(func=cmd_verify)

    p_list = sub.add_parser("list", help="List memory records")
    p_list.add_argument("--ns", default=None, help="Filter by namespace")
    p_list.set_defaults(func=cmd_list)

    p_del = sub.add_parser("delete", help="Delete a memory record")
    p_del.add_argument("namespace", help="Namespace")
    p_del.add_argument("topic", help="Topic name")
    p_del.set_defaults(func=cmd_delete)

    p_promote = sub.add_parser("promote", help="Promote high-traffic or recent L2 topics to CORE.md Semantic Directory")
    p_promote.add_argument("--ns", default=None, help="Filter by namespace")
    p_promote.add_argument("--limit", type=int, default=5, help="Candidate limit (default: 5)")
    p_promote.add_argument("--by", choices=["hits", "recent"], default="hits", help="Sort order: 'hits' or 'recent' (default: hits)")
    p_promote.add_argument("--min-hits", type=int, default=0, help="Minimum access_count filter (default: 0)")
    p_promote.set_defaults(func=cmd_promote)

    p_stats = sub.add_parser("stats", help="Show storage and hit statistics")
    p_stats.set_defaults(func=cmd_stats)

    p_link = sub.add_parser("link", help="Link two memories with a semantic relation")
    p_link.add_argument("source", help="Source memory in <namespace>:<topic> format")
    p_link.add_argument("relation", help="Relation name (e.g. RELATES_TO, DEPENDS_ON, SUPERSEDES)")
    p_link.add_argument("target", help="Target memory in <namespace>:<topic> format")
    p_link.set_defaults(func=cmd_link)

    p_defer = sub.add_parser("defer", help="Defer a prospective task/reminder for a namespace")
    p_defer.add_argument("namespace", help="Namespace (e.g. default, kotlin, rust, proj:<name>)")
    p_defer.add_argument("trigger_cond", help="Trigger condition or event")
    p_defer.add_argument("action", help="Action to take when triggered")
    p_defer.set_defaults(func=cmd_defer)

    p_due = sub.add_parser("due", help="List pending prospective tasks")
    p_due.add_argument("--ns", default=None, help="Filter by namespace")
    p_due.set_defaults(func=cmd_due)

    p_done = sub.add_parser("done", help="Mark a prospective task as completed")
    p_done.add_argument("task_id", type=int, help="Task ID to complete")
    p_done.set_defaults(func=cmd_done)

    p_syn = sub.add_parser("syn", help="Manage dynamic FTS5 synonyms")
    p_syn.add_argument("action", nargs="?", default="list", choices=["list", "add"], help="Action: list or add (default: list)")
    p_syn.add_argument("term", nargs="?", default=None, help="Term to add")
    p_syn.add_argument("synonyms", nargs="?", default=None, help="Comma-separated synonyms")
    p_syn.set_defaults(func=cmd_syn)

    p_recall = sub.add_parser("recall-error", help="Recall episodic error solutions matching an error snippet")
    p_recall.add_argument("error_snippet", help="Error message, stacktrace or snippet")
    p_recall.add_argument("--ns", default=None, help="Filter by namespace")
    p_recall.add_argument("--limit", type=int, default=5, help="Result limit (default: 5)")
    p_recall.set_defaults(func=cmd_recall_error)

    p_check = sub.add_parser("check-core", help="Check CORE.md line count budget and pending prospective tasks")
    p_check.set_defaults(func=cmd_check_core)

    p_export_md = sub.add_parser("export-md", help="Export archival memories to Markdown Wiki with YAML frontmatter")
    p_export_md.add_argument("dir", nargs="?", default=None, help="Target export directory (default: ~/.gemini/memory/wiki)")
    p_export_md.add_argument("--ns", default=None, help="Filter by namespace")
    p_export_md.set_defaults(func=cmd_export_md)

    p_import_md = sub.add_parser("import-md", help="Import memories and graph links from Markdown Wiki files")
    p_import_md.add_argument("dir", nargs="?", default=None, help="Source import directory (default: ~/.gemini/memory/wiki)")
    p_import_md.set_defaults(func=cmd_import_md)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
