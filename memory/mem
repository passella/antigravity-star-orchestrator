def parse_frontmatter(fm_text: str) -> dict:
    data: dict = {
        "namespace": "",
        "topic": "",
        "kind": "fact",
        "tags": "",
        "access_count": 0,
        "ttl_days": None,
        "created_at": None,
        "updated_at": None,
        "links": [],
    }
    in_links = False
    for line in fm_text.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue

        if in_links:
            if stripped.startswith("- "):
                link_item = stripped[2:].strip().strip("\"'")
                data["links"].append(link_item)
                continue
            elif not line.startswith(" ") and not line.startswith("\t"):
                in_links = False

        if ":" in stripped:
            key, val = stripped.split(":", 1)
            key = key.strip()
            val = val.strip()

            if key == "links":
                if val == "[]":
                    data["links"] = []
                    in_links = False
                else:
                    in_links = True
                continue

            # Strip outer quotes and unescape
            if (val.startswith('"') and val.endswith('"')) or (val.startswith("'") and val.endswith("'")):
                val = val[1:-1].replace('\\"', '"').replace("\\\\", "\\")

            if key == "namespace":
                data["namespace"] = val
            elif key == "topic":
                data["topic"] = val
            elif key == "kind":
                data["kind"] = val
            elif key == "tags":
                data["tags"] = val
            elif key == "access_count":
                try:
                    data["access_count"] = int(val)
                except ValueError:
                    data["access_count"] = 0
            elif key == "ttl_days":
                if val.lower() in ("null", "none", "", "~"):
                    data["ttl_days"] = None
                else:
                    try:
                        data["ttl_days"] = int(val)
                    except ValueError:
                        data["ttl_days"] = None
            elif key == "created_at":
                data["created_at"] = val
            elif key == "updated_at":
                data["updated_at"] = val

    return data


def cmd_export_md(args: argparse.Namespace) -> None:
    if args.ns:
        validate_namespace(args.ns)
    wiki_dir = args.dir if args.dir else os.path.join(MEM_DIR, "wiki")
    os.makedirs(wiki_dir, exist_ok=True)
    conn = get_conn()

    sql = """
        SELECT id, namespace, kind, topic, content, tags, access_count, ttl_days, created_at, updated_at
        FROM memories
    """
    params: list = []
    if args.ns:
        sql += " WHERE namespace = ?"
        params.append(args.ns)
    sql += " ORDER BY namespace, topic"

    rows = conn.execute(sql, params).fetchall()
    if not rows:
        print("No memories to export." if not args.ns else f"No memories to export in namespace '{args.ns}'.")
        return

    exported_count = 0
    grouped_for_index: dict[str, list[dict]] = {}
    exported_filepaths: set[str] = set()

    for r in rows:
        m_id = r["id"]
        ns = r["namespace"]
        topic = r["topic"]
        ns_folder = ns.replace(":", "_")
        ns_dir = os.path.join(wiki_dir, ns_folder)
        os.makedirs(ns_dir, exist_ok=True)

        slug = re.sub(r"[^a-zA-Z0-9._-]+", "_", topic).strip("_")
        if not slug:
            slug = "memory"
        filename = f"{slug}.md"
        filepath = os.path.join(ns_dir, filename)
        exported_filepaths.add(os.path.abspath(filepath))

        # Outgoing edges
        out_edges = conn.execute(
            """
            SELECT e.relation, m.namespace, m.topic
            FROM memory_edges e
            JOIN memories m ON e.target_id = m.id
            WHERE e.source_id = ?
            ORDER BY e.relation, m.namespace, m.topic
            """,
            (m_id,),
        ).fetchall()

        # Incoming edges
        in_edges = conn.execute(
            """
            SELECT e.relation, m.namespace, m.topic
            FROM memory_edges e
            JOIN memories m ON e.source_id = m.id
            WHERE e.target_id = ?
            ORDER BY e.relation, m.namespace, m.topic
            """,
            (m_id,),
        ).fetchall()

        # Links in frontmatter (outgoing links)
        if not out_edges:
            links_yaml = "links: []"
        else:
            links_lines = ["links:"]
            for e in out_edges:
                links_lines.append(f'  - "{e["relation"]} -> {e["namespace"]}:{e["topic"]}"')
            links_yaml = "\n".join(links_lines)

        ttl_yaml = str(r["ttl_days"]) if r["ttl_days"] is not None else "null"
        clean_tags = (r["tags"] or "").replace('\\', '\\\\').replace('"', '\\"')
        clean_topic = topic.replace('\\', '\\\\').replace('"', '\\"')
        clean_ns = ns.replace('\\', '\\\\').replace('"', '\\"')

        frontmatter = f"""---
namespace: "{clean_ns}"
topic: "{clean_topic}"
kind: "{r['kind']}"
tags: "{clean_tags}"
access_count: {r['access_count']}
ttl_days: {ttl_yaml}
created_at: "{r['created_at']}"
updated_at: "{r['updated_at']}"
{links_yaml}
---"""

        # Semantic links section
        semantic_section = ""
        if out_edges or in_edges:
            s_lines = ["\n## 🔗 Links Semânticos"]
            for e in out_edges:
                s_lines.append(f"- **{e['relation']}** -> [[{e['namespace']}/{e['topic']}]]")
            for e in in_edges:
                s_lines.append(f"- *referenced by* **{e['relation']}** <- [[{e['namespace']}/{e['topic']}]]")
            semantic_section = "\n" + "\n".join(s_lines)

        file_content = f"{frontmatter}\n\n# {topic}\n\n{r['content'].strip()}{semantic_section}\n"

        with open(filepath, "w", encoding="utf-8") as f:
            f.write(file_content)

        exported_count += 1
        rel_link = f"{ns_folder}/{filename}"
        grouped_for_index.setdefault(ns, []).append({
            "topic": topic,
            "kind": r["kind"],
            "tags": r["tags"] or "",
            "link": rel_link,
            "updated_at": r["updated_at"],
            "summary": make_summary(r["content"], r["tags"] or ""),
        })

    # Write INDEX.md
    index_path = os.path.join(wiki_dir, "INDEX.md")
    index_lines = [
        "# 📚 Antigravity Memory Wiki Index",
        "",
        f"> Generated on: {now_iso()} | Total memories: {exported_count}",
        "",
        "## Namespaces",
    ]
    for ns, items in grouped_for_index.items():
        ns_anchor = ns.replace(":", "").replace("_", "-").lower()
        index_lines.append(f"- [`{ns}`](#{ns_anchor}) ({len(items)} memories)")

    index_lines.append("")
    for ns, items in grouped_for_index.items():
        index_lines.append(f"## `{ns}`")
        index_lines.append("")
        for it in items:
            tags_str = f" | tags: {it['tags']}" if it['tags'] else ""
            index_lines.append(f"- [{it['topic']}]({it['link']}) (`{it['kind']}`{tags_str}) — {it['summary']}")
        index_lines.append("")

    with open(index_path, "w", encoding="utf-8") as f:
        f.write("\n".join(index_lines))

    # Clean up obsolete .md files if full export (not filtered by --ns)
    if not args.ns:
        for root, _, files in os.walk(wiki_dir):
            for f in files:
                if f.endswith(".md"):
                    fp = os.path.abspath(os.path.join(root, f))
                    if fp not in exported_filepaths and fp != os.path.abspath(index_path):
                        try:
                            os.remove(fp)
                        except OSError:
                            pass
        # Remove empty dirs
        for root, dirs, _ in os.walk(wiki_dir, topdown=False):
            for d in dirs:
                dp = os.path.join(root, d)
                try:
                    if not os.listdir(dp):
                        os.rmdir(dp)
                except OSError:
                    pass

    print(f"[OK] Exported {exported_count} memories to {wiki_dir}")
    print(f"[OK] Generated index at {index_path}")


def cmd_import_md(args: argparse.Namespace) -> None:
    wiki_dir = args.dir if args.dir else os.path.join(MEM_DIR, "wiki")
    if not os.path.isdir(wiki_dir):
        sys.exit(f"Error: import directory not found: {wiki_dir}")

    conn = get_conn()
    ts = now_iso()
    imported_records = []
    all_links = []

    for root, _, files in os.walk(wiki_dir):
        for f in files:
            if not f.endswith(".md") or f == "INDEX.md":
                continue
            filepath = os.path.join(root, f)
            with open(filepath, "r", encoding="utf-8") as fp:
                raw_text = fp.read()

            m = re.match(r"^\s*---\s*\n(.*?)\n---\s*\n(.*)$", raw_text, re.DOTALL)
            if not m:
                continue

            fm_text = m.group(1)
            body = m.group(2)

            data = parse_frontmatter(fm_text)
            ns = data["namespace"]
            topic = data["topic"]
            if not ns or not topic:
                continue
            if not is_valid_namespace(ns):
                print(f"[WARN] Skipping {filepath}: invalid namespace '{ns}'")
                continue

            # Clean body: strip Links Semanticos and # <topic> header
            body_no_links = re.split(r"\n##\s+🔗\s+Links Semânticos", body)[0]
            clean_body = re.sub(r"^\s*#\s+[^\n]*\n", "", body_no_links, count=1).strip()

            kind = data["kind"] if data["kind"] in VALID_KINDS else "fact"
            created_at = data["created_at"] or ts
            updated_at = data["updated_at"] or ts
            access_count = data["access_count"]
            ttl_days = data["ttl_days"]
            tags = data["tags"]

            imported_records.append((ns, kind, topic, clean_body, tags, access_count, ttl_days, created_at, updated_at))
            for link_str in data["links"]:
                all_links.append((ns, topic, link_str))

    if not imported_records:
        print(f"No valid markdown memory files found in {wiki_dir}")
        return

    with conn:
        for rec in imported_records:
            conn.execute(
                """
                INSERT INTO memories (namespace, kind, topic, content, tags, access_count, ttl_days, created_at, updated_at)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
                ON CONFLICT(namespace, topic) DO UPDATE SET
                    kind = excluded.kind,
                    content = excluded.content,
                    tags = excluded.tags,
                    access_count = excluded.access_count,
                    ttl_days = excluded.ttl_days,
                    created_at = excluded.created_at,
                    updated_at = excluded.updated_at
                """,
                rec,
            )

    # Restore links
    restored_links_count = 0
    with conn:
        for src_ns, src_topic, link_str in all_links:
            if "->" not in link_str:
                continue
            rel_part, target_part = link_str.split("->", 1)
            rel = rel_part.strip().upper()
            target_clean = target_part.strip()
            if ":" not in target_clean:
                continue
            dst_ns, dst_topic = target_clean.split(":", 1)
            src_row = conn.execute("SELECT id FROM memories WHERE namespace = ? AND topic = ?", (src_ns, src_topic)).fetchone()
            dst_row = conn.execute("SELECT id FROM memories WHERE namespace = ? AND topic = ?", (dst_ns, dst_topic)).fetchone()
            if src_row and dst_row:
                cur = conn.execute(
                    """
                    INSERT OR IGNORE INTO memory_edges (source_id, target_id, relation, created_at)
                    VALUES (?, ?, ?, ?)
                    """,
                    (src_row["id"], dst_row["id"], rel, ts),
                )
                if cur.rowcount:
                    restored_links_count += 1

    print(f"[OK] Imported {len(imported_records)} memories from {wiki_dir}")
    print(f"[OK] Restored {restored_links_count} semantic links into memory_edges")


